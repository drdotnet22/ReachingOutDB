@using ReachingOutDB.Data
@using Syncfusion.Blazor.MultiColumnComboBox
@using Syncfusion.Blazor.DataForm

@inject IntlPackageServices intlPackageService
@inject CustomerServices customerService



@if (ThisPackage != null)
{
   <SfDataForm ID="intl-package-edit-form"
            Model="@ThisPackage"
            OnValidSubmit="OnValidSubmitHandler">
       <FormValidator>
           <DataAnnotationsValidator />
           <ValidationSummary />
       </FormValidator>

       <FormTemplate>
            <div class="myflexcolumn">
                <div class="myflexrow">
                    <SfMultiColumnComboBox TItem="Customer" TValue="int" AllowFiltering="true"
                                           FilterType="Syncfusion.Blazor.MultiColumnComboBox.FilterType.Contains"
                                           @bind-Value="ThisPackage.CustomerId"
                                           ValueChange="OnCustomerChanged"
                                           DataSource="CustomerList"
                                           ValueField="CustomerId"
                                           TextField="CustomerName"
                                           Width="600px"
                                           ShowClearButton="false"
                                           Placeholder="Customer" FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always">
                        <MultiColumnComboboxColumns>
                            <MultiColumnComboboxColumn Field="CustomerId" Header="ID" Width="80px" />
                            <MultiColumnComboboxColumn Field="CustomerName" Header="Customer Name" />
                        </MultiColumnComboboxColumns>
                    </SfMultiColumnComboBox>
                </div>
                <div class="myflexrow">
                    <SfTextBox @bind-Value="ThisPackage.Company"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Company (label)" />
                    <SfTextBox @bind-Value="ThisPackage.ContactName"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Contact name" />
                </div>
                <div class="myflexrow">
                    <SfTextBox @bind-Value="ThisPackage.Address1"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Address line 1" />
                    <SfTextBox @bind-Value="ThisPackage.Address2"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Address line 2" />
                </div>
                <div class="myflexrow">
                    <SfTextBox @bind-Value="ThisPackage.City"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="City" />

                    <SfTextBox @bind-Value="ThisPackage.State"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="State" />

                    <SfTextBox @bind-Value="ThisPackage.ZipCode"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Zip code" />

                    <SfTextBox @bind-Value="ThisPackage.Country"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Country" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox @bind-Value="ThisPackage.Qty" FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always" Placeholder="Quantity" ShowSpinButton="false" />
                    <SfTextBox @bind-Value="ThisPackage.BoxNote"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Box note (eg. Box 1 of 3)" />
                </div>
            </div>
       </FormTemplate>
   </SfDataForm>
   <br />
}

@code {
    [Parameter]
    public IntlPackage ThisPackage { get; set; }

    [Parameter]
    public EventCallback CloseDialog { get; set; }

    private IEnumerable<Customer> CustomerList { get; set; }
    // The last customer name we auto-filled into Company, used to tell an untouched default
    // apart from a company name the user deliberately typed so we don't clobber overrides.
    private string? autoFilledCompany;

    protected override async Task OnInitializedAsync()
    {
        CustomerList = await customerService.GetCustomersAsync();
        if (ThisPackage == null)
        {
            ThisPackage = new IntlPackage();
        }
    }

    private void OnCustomerChanged(Syncfusion.Blazor.MultiColumnComboBox.ValueChangeEventArgs<int, Customer> args)
    {
        var customerName = args.ItemData?.CustomerName;
        if (string.IsNullOrWhiteSpace(customerName))
        {
            return;
        }

        // Default Company to the customer name, but leave a value the user typed themselves intact.
        if (string.IsNullOrWhiteSpace(ThisPackage.Company) || ThisPackage.Company == autoFilledCompany)
        {
            ThisPackage.Company = customerName;
            autoFilledCompany = customerName;
        }
    }

    public async Task OnValidSubmitHandler()
    {
        ThisPackage.Customer = null;
        await intlPackageService.UpdateIntlPackageAsync(ThisPackage);
        CloseDialog.InvokeAsync();
    }
}
