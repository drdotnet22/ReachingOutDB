@using ReachingOutDB.Data
@using Syncfusion.Blazor.MultiColumnComboBox
@using Syncfusion.Blazor.DataForm

@inject PackageServices packageService
@inject CustomerServices customerService



@if (ThisPackage != null)
{
   <SfDataForm ID="package-edit-form" 
            Model="@ThisPackage"
            OnValidSubmit="OnValidSubmitHandler">
       <FormValidator>
           <DataAnnotationsValidator />
           <ValidationSummary />
       </FormValidator>

       <FormTemplate>
            <div class="myflexcolumn">
                <div class="myflexrow">
                    <SfMultiColumnComboBox TItem="Customer" TValue="int" AllowFiltering="true"
                                           FilterType="Syncfusion.Blazor.MultiColumnComboBox.FilterType.Contains"
                                           @bind-Value="ThisPackage.CustomerId"
                                           DataSource="CustomerList"
                                           ValueField="CustomerId"
                                           TextField="CustomerName"
                                           Width="600px"
                                           ShowClearButton="false"
                                           Placeholder="Customer" FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always">
                        <MultiColumnComboboxColumns>
                            <MultiColumnComboboxColumn Field="CustomerId" Header="ID" Width="80px" />
                            <MultiColumnComboboxColumn Field="CustomerName" Header="Customer Name" />
                        </MultiColumnComboboxColumns>
                    </SfMultiColumnComboBox>
                    <SfTextBox @bind-Value="ThisPackage.ContactName"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Contact name" />
                </div>
                <div class="myflexrow">

                    <SfTextBox @bind-Value="ThisPackage.Address"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Address" />
                    <SfTextBox @bind-Value="ThisPackage.City"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="City" />

                    <SfTextBox @bind-Value="ThisPackage.State"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="State" />

                    <SfTextBox @bind-Value="ThisPackage.ZipCode"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Zip code" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox @bind-Value="ThisPackage.Qty" FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always" Placeholder="Quantity" ShowSpinButton="false" />
                    <SfTextBox @bind-Value="ThisPackage.MailClass"
                               FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                               Placeholder="Mail class" />
                    <SfDropDownList TItem="PackageTypeItem" TValue="PackageType"
                            @bind-Value="ThisPackage.PackageType"
                            DataSource="@PackageTypeItems"
                            FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                            Placeholder="Package Type">
                        <DropDownListFieldSettings Text="DisplayName" Value="Value"></DropDownListFieldSettings>
                    </SfDropDownList>
                    <SfDropDownList TItem="PackageOption" TValue="Guid"
                                    @bind-Value="ThisPackage.PackageOptionId"
                                    DataSource="@PackageOptionList"
                                    FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always"
                                    Placeholder="Packaging">
                        <DropDownListFieldSettings Value="PackageOptionId" Text="PackageDescription" />
                    </SfDropDownList>
                </div>
            </div>
       </FormTemplate>
   </SfDataForm>
   <br />
}

@code {
    [Parameter]
    public Package ThisPackage { get; set; }

    [Parameter]
    public EventCallback CloseDialog { get; set; }

    private IEnumerable<Customer> CustomerList { get; set; }
    private IEnumerable<PackageOption> PackageOptionList { get; set; }
    private List<PackageTypeItem> PackageTypeItems { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CustomerList = await customerService.GetCustomersAsync();
        PackageOptionList = await packageService.GetPackageOptionsAsync();
        if (ThisPackage == null)
        {
            ThisPackage = new Package();
        }

        PackageTypeItems = Enum.GetValues(typeof(PackageType))
            .Cast<PackageType>()
            .Select(pt => new PackageTypeItem
            {
                Value = pt,
                DisplayName = GetPackageTypeDisplayName(pt)
            })
            .ToList();
    }

    public async Task OnValidSubmitHandler()
    {
        ThisPackage.Customer = null;
        ThisPackage.PackageOption = null;
        await packageService.UpdatePackageAsync(ThisPackage);
        CloseDialog.InvokeAsync();
    }

    public class PackageTypeItem
    {
        public PackageType Value { get; set; }
        public string DisplayName { get; set; }
    }

    private string GetPackageTypeDisplayName(PackageType packageType)
    {
        var displayAttribute = packageType.GetType()
            .GetField(packageType.ToString())
            ?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
            .FirstOrDefault() as System.ComponentModel.DataAnnotations.DisplayAttribute;
        return displayAttribute?.Name ?? packageType.ToString();
    }
}