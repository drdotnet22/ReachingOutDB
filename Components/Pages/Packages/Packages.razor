@page "/packages"
@using ReachingOutDB.Data
@inject PackageServices packageService
@inject CustomerServices customerService
@inject MiscSettingsServices miscSettingsService
@inject YearQuarterService yearQuarterService
@inject OrderServices orderService
@inject UserServices userService
@inject SfDialogService DialogService
@implements IDisposable


<PageTitle>Packages</PageTitle>

<h3>Package Management</h3>

@if (packageIssues.Any())
{
    <div style="border: 1px solid #e0a800; background: #fff3cd; color: #664d03; border-radius: 4px; padding: 10px 14px; margin-bottom: 16px;">
        <strong>⚠️ @packageIssues.Count USPS order(s) need attention for @yearQuarterService.SelectedYear @yearQuarterService.SelectedQuarter:</strong>
        <ul style="margin: 6px 0 0 0; padding-left: 20px;">
            @foreach (var issue in packageIssues)
            {
                <li>
                    <strong>@issue.Order?.Customer.CustomerName (@issue.Order?.CustomerId)</strong> — 
                    @if (issue.IssueType == UspsPackageIssueType.MissingPackage)
                    {
                        <span>USPS order for @issue.PostalQty but no shipping package on file.</span>
                    }
                    else if (issue.IssueType == UspsPackageIssueType.QuantityMismatch)
                    {
                        <span>packages total @issue.PackagedQty, but the USPS order is for @issue.PostalQty.</span>
                    }
                    else if (issue.IssueType == UspsPackageIssueType.ExtraPackage)
                    {
                        <span>shipping package on file, but no USPS order this quarter.</span>
                    }
                </li>
            }
        </ul>
    </div>
}

<div class="myflexrow" style="margin-bottom: 20px;">
    <div style="display: inline-block">
        <span style="margin-right: 12px; font-weight:bold;">Package type filter:</span>
        @foreach (PackageType type in Enum.GetValues(typeof(PackageType)))
        {
            <span style="margin-right: 15px;">
                <SfCheckBox Label="@GetPackageTypeDisplayName(type)"
                            @bind-Checked="@SelectedPackageTypes[type]"
                            @onchange="OnPackageTypeFilterChanged">
                </SfCheckBox>
            </span>
        }
    </div>
    <div style="display: inline-block; border-left: 1px solid #ccc; padding-left: 25px;">
        <span style="margin-right: 12px; font-weight:bold;">Shipping status (this quarter):</span>
        <span style="margin-right: 15px;">
            <SfCheckBox TChecked="bool" Label="All"
                Checked="@FilterAll"
                ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> e) => OnAllFilterChanged(e.Checked))">
            </SfCheckBox>
        </span>
        <span style="margin-right: 15px;">
            <SfCheckBox TChecked="bool" Label="Ready to ship"
                Checked="@filterReadyToShip"
                ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> e) => OnStatusFilterChanged(JobStatus.ReadyToShip, e.Checked))">
            </SfCheckBox>
        </span>
        <span>
            <SfCheckBox TChecked="bool" Label="Shipped"
                Checked="@filterShipped"
                ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> e) => OnStatusFilterChanged(JobStatus.Shipped, e.Checked))">
            </SfCheckBox>
        </span>
    </div>
</div>

<SfGrid @ref="Grid" DataSource="@filteredPackages" AllowSorting="true" AllowResizing="true" RowHeight="30" Toolbar="@ToolbarItems" AllowExcelExport="true" AllowSelection="true">
    <GridEvents TValue="Package" OnActionBegin="ActionBeginHandler" OnActionComplete="ActionCompleteHandler" OnToolbarClick="ToolbarClickHandler" ExcelQueryCellInfoEvent="ExcelQueryCellInfoHandler" CommandClicked="CommandClickedHandler"></GridEvents>
    <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
    <GridSortSettings>
        <GridSortColumns>
            <GridSortColumn Field="Qty" Direction="Syncfusion.Blazor.Grids.SortDirection.Ascending" />
        </GridSortColumns>
    </GridSortSettings>
    <GridEditSettings AllowAdding="true" AllowEditing="false" AllowDeleting="true" />
    <GridColumns>
        <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn>
        <GridForeignColumn Field="@nameof(Package.CustomerId)" ForeignKeyValue="CustomerName" ForeignDataSource="@customers" HeaderText="Customer Name" />
        <GridColumn Field="@nameof(Package.CustomerId)" HeaderText="Customer ID" />
        <GridColumn Field="@nameof(Package.ContactName)" HeaderText="Contact Name" />
        <GridColumn Field="@nameof(Package.Address)" HeaderText="Address" Width="250" />
        <GridColumn Field="@nameof(Package.City)" HeaderText="City" Width="150" />
        <GridColumn Field="@nameof(Package.State)" HeaderText="State" Width="85" />
        <GridColumn Field="@nameof(Package.ZipCode)" HeaderText="Zip Code" Width="100" />
        <GridColumn Field="@nameof(Package.Qty)" HeaderText="Quantity" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Weight" TextAlign="TextAlign.Right" >
            <Template>
                @{
                    var package = (context as Package);
                    if (package.PackageOption != null)
                    {
                        var weight = (package.Qty * miscSetting.MagazineWeight) + package.PackageOption.PackagingWeight;
                        <div>@weight</div>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(Package.MailClass)" HeaderText="Mail Class" Width="100" />
        <GridColumn Field="@nameof(Package.PackageType)" HeaderText="Package Type" />
        <GridForeignColumn Field="@nameof(Package.PackageOptionId)" ForeignKeyValue="PackageDescription" ForeignDataSource="@packageOptions" HeaderText="Packaging" />
        <GridForeignColumn Field="@nameof(Package.PackageOptionId)" ForeignKeyValue="Length" ForeignDataSource="@packageOptions" HeaderText="PackageLength" Visible="exportColumnsVisible" />
        <GridForeignColumn Field="@nameof(Package.PackageOptionId)" ForeignKeyValue="Width" ForeignDataSource="@packageOptions" HeaderText="PackageWidth" Visible="exportColumnsVisible" />
        <GridForeignColumn Field="@nameof(Package.PackageOptionId)" ForeignKeyValue="Height" ForeignDataSource="@packageOptions" HeaderText="PackageHeight" Visible="exportColumnsVisible" />
        <GridColumn Width="110">
            <GridCommandColumns>
                <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })" />
                <GridCommandColumn Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-delete", CssClass = "e-flat" })" />
            </GridCommandColumns>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @ref="packageEditDialog" Width="900" Visible=false ShowCloseIcon="true" >
    <DialogTemplates>
        <Header>
            <span>@GetHeader(selectedPackage)</span>
        </Header>
        <Content>
            <PackageViewEdit ThisPackage="selectedPackage" CloseDialog="ClosePackageEditDialog" />
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private SfGrid<Package> Grid;
    private IEnumerable<Package> packages { get; set; }
    private IEnumerable<Package> filteredPackages { get; set; }
    private IEnumerable<Customer> customers { get; set; }
    private IEnumerable<PackageOption> packageOptions { get; set; }
    private List<Object> ToolbarItems = new List<Object>()
    {
        "Add", "CsvExport", "Search",
        new Syncfusion.Blazor.Navigations.ItemModel
        {
            Text = "Mark Shipped",
            Id = "MarkShipped",
            TooltipText = "Mark the ready-to-ship USPS orders for the selected packages as shipped",
            PrefixIcon = "e-icons e-check"
        }
    };
    private bool exportColumnsVisible = false;
    public MiscSetting miscSetting;
    public Package selectedPackage = new Package();
    private Dictionary<PackageType, bool> SelectedPackageTypes { get; set; } = new();
    // "Ready to ship" and "Shipped" are independent, additive status filters. "All" is on whenever
    // neither is selected, so unchecking the last status automatically falls back to showing all.
    private bool filterReadyToShip = false;
    private bool filterShipped = false;
    private bool FilterAll => !filterReadyToShip && !filterShipped;
    private List<UspsPackageIssue> packageIssues { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        foreach (PackageType packageType in Enum.GetValues(typeof(PackageType)))
        {
            SelectedPackageTypes[packageType] = true; // Start with all selected
        }

        yearQuarterService.OnYearQuarterChanged += YearQuarterChanged;
        customers = await customerService.GetCustomersAsync();
        packageOptions = await packageService.GetPackageOptionsAsync();
        miscSetting = await miscSettingsService.GetMiscSettingsAsync();
        await RefreshPackages();
        await base.OnInitializedAsync();
    }

    private async void YearQuarterChanged()
    {
        await RefreshPackages();
    }

    private async Task RefreshPackages()
    {
        var year = yearQuarterService.SelectedYear;
        var quarter = yearQuarterService.SelectedQuarter;
        if (FilterAll)
        {
            packages = await packageService.GetPackagesAsync();
        }
        else
        {
            var statuses = new List<JobStatus>();
            if (filterReadyToShip) statuses.Add(JobStatus.ReadyToShip);
            if (filterShipped) statuses.Add(JobStatus.Shipped);
            packages = await packageService.GetPackagesByOrderStatusAsync(year, quarter, statuses);
        }
        packageIssues = await packageService.GetUspsPackageIssuesAsync(year, quarter);
        ApplyPackageTypeFilter();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAllFilterChanged(bool isChecked)
    {
        if (isChecked)
        {
            // Selecting All clears the status filters. Re-clicking All when it's already the
            // active state is a no-op, but re-render so the box stays checked.
            filterReadyToShip = false;
            filterShipped = false;
            await RefreshPackages();
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnStatusFilterChanged(JobStatus status, bool isChecked)
    {
        if (status == JobStatus.ReadyToShip) filterReadyToShip = isChecked;
        else if (status == JobStatus.Shipped) filterShipped = isChecked;
        await RefreshPackages();
    }

    public void Dispose()
    {
        yearQuarterService.OnYearQuarterChanged -= YearQuarterChanged;
    }

    private string GetPackageTypeDisplayName(PackageType packageType)
    {
        var displayAttribute = packageType.GetType()
            .GetField(packageType.ToString())
            ?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
            .FirstOrDefault() as System.ComponentModel.DataAnnotations.DisplayAttribute;
        return displayAttribute?.Name ?? packageType.ToString();
    }

    private void OnPackageTypeFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        ApplyPackageTypeFilter();
        StateHasChanged();
    }

    private void ApplyPackageTypeFilter()
    {
        var selectedPackageTypesList = SelectedPackageTypes
            .Where(kvp => kvp.Value)
            .Select(kvp => kvp.Key)
            .ToList();

        if (selectedPackageTypesList.Any())
        {
            filteredPackages = packages
                .Where(p => selectedPackageTypesList.Contains(p.PackageType))
                .ToList();
        }
        else
        {
            filteredPackages = new List<Package>();
        }
    }

    private async Task ActionBeginHandler(ActionEventArgs<Package> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            args.Cancel = true;
            await packageService.DeletePackageAsync(args.Data);
            await RefreshPackages();
        }
    }

    public async Task CommandClickedHandler(CommandClickEventArgs<Package> args)
    {
        if (args.CommandColumn.Type == CommandButtonType.Edit)
        {
            selectedPackage = args.RowData;
            await packageEditDialog.ShowAsync();
            args.Cancel = true;
        }
        else if (args.CommandColumn.Type == CommandButtonType.Delete)
        {
            bool isConfirm = await DialogService.ConfirmAsync("Are you sure you want to permanently delete this package? This action cannot be undone", "Delete");
            if (isConfirm)
            {
                ActionEventArgs<Package> actionEventArgs = new ActionEventArgs<Package>();
                actionEventArgs.Data = args.RowData;
                await ActionBeginHandler(actionEventArgs);
            }
        }
    }

    private async Task ActionCompleteHandler(ActionEventArgs<Package> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save) || args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            await Grid.Refresh();
        }
    }

    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Text == "Add")
        {
            selectedPackage = null;
            packageEditDialog.ShowAsync();
            args.Cancel = true;
        }
        else if (args.Item.Text == "CSV Export")
        {
            var selectedRecords = await Grid.GetSelectedRecordsAsync();
            ExcelExportProperties ExportProperties = new ExcelExportProperties
            {
                IncludeTemplateColumn = true,
                IncludeHiddenColumn = true,
                DataSource = selectedRecords
            };
            await Grid.ExportToCsvAsync(ExportProperties);
        }
        else if (args.Item.Id == "MarkShipped")
        {
            args.Cancel = true;
            await MarkSelectedPackagesShipped();
        }
    }

    // Marks the ready-to-ship USPS orders belonging to the selected packages' customers (in the
    // currently selected period) as shipped. A package maps to an order via customer + period.
    private async Task MarkSelectedPackagesShipped()
    {
        var selectedPackages = await Grid.GetSelectedRecordsAsync();
        if (selectedPackages == null || !selectedPackages.Any())
        {
            await DialogService.AlertAsync("Select one or more packages first.", "No packages selected");
            return;
        }

        var customerIds = selectedPackages.Select(p => p.CustomerId).Distinct().ToHashSet();
        var periodOrders = await orderService.GetOrdersAsync(yearQuarterService.SelectedYear, yearQuarterService.SelectedQuarter);
        var ordersToShip = periodOrders
            .Where(o => customerIds.Contains(o.CustomerId)
                     && o.PostalQty > 0
                     && o.JobStatus == JobStatus.ReadyToShip)
            .ToList();

        if (!ordersToShip.Any())
        {
            await DialogService.AlertAsync(
                "None of the selected packages have a ready-to-ship USPS order this quarter.",
                "Nothing to mark");
            return;
        }

        bool confirmed = await DialogService.ConfirmAsync(
            $"Mark {ordersToShip.Count} USPS order(s) as shipped for {yearQuarterService.SelectedYear} {yearQuarterService.SelectedQuarter}?",
            "Confirm mark shipped");
        if (!confirmed)
        {
            return;
        }

        foreach (var order in ordersToShip)
        {
            order.JobStatus = JobStatus.Shipped;
            try
            {
                await orderService.UpdateOrderAsync(order, userService.CurrentUser.Name);
            }
            catch (Exception ex)
            {
                await DialogService.AlertAsync(
                    $"Could not update order for {order.Customer?.CustomerName}: {ex.Message}",
                    "Update failed");
            }
        }

        await RefreshPackages();
    }

    public void ExcelQueryCellInfoHandler(ExcelQueryCellInfoEventArgs<Package> args)
    {
        if (args.Column.HeaderText == "Weight")
        {
            var weight = (args.Data.Qty * miscSetting.MagazineWeight) + args.Data.PackageOption.PackagingWeight;
            args.Cell.Value = weight.ToString();
        }
        // If mailclass is "FCF" set PackageLength, PackageWidth, and PackageHeight to null
        if (args.Column.HeaderText == "PackageLength" || args.Column.HeaderText == "PackageWidth" || args.Column.HeaderText == "PackageHeight")
        {
            if (args.Data.MailClass == "FCF")
            {
                args.Cell.Value = null;
            }
        }
    }

    private string GetHeader(Package package)
    {
        if (selectedPackage == null)
        {
            return "Add New Package";
        }
        else
        {
            return $"Edit Package - {package?.ContactName}";
        }
    }

    SfDialog packageEditDialog;

    private async Task ClosePackageEditDialog()
    {
        await packageEditDialog.HideAsync();
        await RefreshPackages();
    }
}