@using ReachingOutDB.Data
@inject UserServices userService
@implements IDisposable

<SfDropDownList TItem="UserProfile" TValue="int" DataSource="@userProfiles" Value="@ActiveUserId" Width="150px">
    <DropDownListFieldSettings Text="Name" Value="UserProfileId" />
    <DropDownListEvents TValue="int" TItem="UserProfile" ValueChange="OnUserSelected" />
</SfDropDownList>

@code {
    private int ActiveUserId = 0;
    private List<UserProfile> userProfiles { get; set; }

    protected override async Task OnInitializedAsync()
    {
        userProfiles = await userService.GetUserListAsync();
        userService.OnUserChanged += OnUserChanged;
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await userService.InitializeAsync();
            if (userService.CurrentUser != null)
            {
                ActiveUserId = userService.CurrentUser.UserProfileId; //error if user has not been assigned
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task OnUserSelected(ChangeEventArgs<int, UserProfile> userId)
    {
        ActiveUserId = userId.Value;
        await userService.SelectUserAsync(userId.Value);
    }

    private async void OnUserChanged()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (userService.CurrentUser != null)
                {
                    ActiveUserId = userService.CurrentUser.UserProfileId;
                }
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    public void Dispose()
    {
        userService.OnUserChanged -= OnUserChanged;
    }
}
