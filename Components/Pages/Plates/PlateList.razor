@page "/platelist"

@using ReachingOutDB.Data
@using ReachingOutDB.Components.Shared

@inject PlateServices plateService
@inject OrderServices orderService
@inject YearQuarterService yearQuarterService
@inject IJSRuntime JSRuntime
@implements IDisposable


@if (filteredPlates != null)
{

    <span>Blank plates needed: @blanksNeeded</span>
    <span>Blank sheets plated: @blankSheets</span><br/>
    <span>Total press sheets printed: @pressSheetsPrinted</span><br />
    <span>Efficiency: @efficiency.ToString("P1")</span>
    <div class="myflexrow" style="align-items:center">
        <h3>PlateList</h3>
        <FluentButton Title="Print Plate List" OnClick="Print">
            <FluentIcon Value="@(new Icons.Regular.Size20.Print())" Color="Color.Neutral" />
        </FluentButton>
    </div>
    <div class="card-container" id="printArea">
        @foreach (var plate in filteredPlates)
        {
            bool onHold = plate.PlateAssignments?.Any(assignment =>
            assignment.OrderId != null &&
            assignment.Order.JobStatus == JobStatus.OnHold) ?? false;

            int sequence = filteredPlates.IndexOf(plate) + 1;

            <PlateDetails Plate="@plate" OnPlateUpdated="RefreshPlates" Sequence="@sequence" OnHold="@onHold" />
        }
    </div>
}
else
{
    <span>No plates to list.</span>
}
@code {
    public int blankSheets { get; set; }
    public int blanksNeeded { get; set; }
    public int platedOrderTotal { get; set; }
    public int pressSheetsPrinted { get; set; }
    public double efficiency { get; set; }
    public List<Plate> filteredPlates { get; set; }
    public IEnumerable<Order> unplatedOrders { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshPlates();
        yearQuarterService.OnYearQuarterChanged += YearQuarterChanged;
        await base.OnInitializedAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshPlates();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task RefreshPlates()
    {
        IEnumerable<Order> orders = await orderService.GetOrdersIncludePlateAssignmentsAsync(yearQuarterService.SelectedYear, yearQuarterService.SelectedQuarter);
        blanksNeeded = orders
            .Where(o => o.Qty < 1000)
            .Where(o => !o.PlateAssignments.Any())
            .Sum(o => o.Qty);

        platedOrderTotal = orders
            .Where(o => o.PlateAssignments.Any())
            .Sum(o => o.Qty);

        filteredPlates = await plateService.GetFilteredPlatesAsync(yearQuarterService.SelectedYear, yearQuarterService.SelectedQuarter);
        blankSheets = filteredPlates
            .SelectMany(p => p.PlateAssignments)
            .Where(pa => pa.IsBlank == true)
            .Sum(pa => pa.Plate.Quantity);

        pressSheetsPrinted = filteredPlates.Sum(p => p.Quantity);

        int platedQty = filteredPlates.Sum(p => p.Quantity);

        efficiency = ((double)(blanksNeeded + 2000 + platedOrderTotal)) / (platedQty * 4);
        StateHasChanged();
    }

    public async Task PlateOrder(Plate plate)
    {
        await plateService.MarkPlatedAsync(plate);
        await RefreshPlates();
    }

    public async Task DeletePlate(Plate plate)
    {
        await plateService.DeletePlateAsync(plate);
        await RefreshPlates();
    }

    private async void YearQuarterChanged()
    {
        try
        {
            await InvokeAsync(RefreshPlates);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    private async Task Print()
    {
        await JSRuntime.InvokeVoidAsync("printElement", "printArea");
    }

    public void Dispose()
    {
        yearQuarterService.OnYearQuarterChanged -= YearQuarterChanged;
    }
}

<style>
    .card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 16px; /* Adjust spacing between cards as needed */
    }
</style>
