@using ReachingOutDB.Data
@using ReachingOutDB.Components.Shared

@inject OrderServices orderService
@inject CustomerServices customerService
@inject UserServices userService
@inject YearQuarterService yearQuarterService
@inject PlateServices plateService
@inject SfDialogService DialogService
@implements IDisposable

<PageTitle>Orders - Reaching Out</PageTitle>

@if (userService.CurrentUser.Role != UserRole.UnAssigned)
{
    <div style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">
        @* Custom toolbar for each type of user *@
        <SfToolbar>
            <ToolbarEvents Clicked="ToolbarClickHandler" />
            <ToolbarItems>
                @if (userService.CurrentUser.Role == UserRole.Admin)
                {
                    <ToolbarItem Text="Add" TooltipText="Add single or batch orders" PrefixIcon="e-duplicate icon" />
                    <ToolbarItem>
                        <Template>
                            <div class="myflexrow">
                                <span>Admin mode:</span>
                                <SfSwitch @bind-Checked="superAdmin" />
                            </div>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Text="CSV Export" TooltipText="Export filtered records to csv" PrefixIcon="e-export-csv icon" Visible="@superAdmin" />
                    <ToolbarItem Text="Assign Plates" TooltipText="Assign plates to all orders for this quarter" Visible="@superAdmin" />
                    <ToolbarItem Text="Import Endicia" TooltipText="Import print log export from Endicia" Visible="@superAdmin" />
                    <ToolbarItem Type="ItemType.Spacer" />
                    <ToolbarItem>
                        <Template>
                            <DuploProgress Orders="orders" />
                        </Template>
                    </ToolbarItem>
                }
                else if (userService.CurrentUser.Role == UserRole.Duplo)
                {
                    <ToolbarItem Text="Saddle Stitched" TooltipText="Mark selected rows as saddlestitched." PrefixIcon="e-circle-check icon" />
                    <ToolbarItem Type="ItemType.Spacer" />
                    <ToolbarItem>
                        <Template>
                            <DuploProgress Orders="orders" />
                        </Template>
                    </ToolbarItem>
                }
                <ToolbarItem Type="ItemType.Spacer" />
                <ToolbarItem TooltipText="Search grid contents" Type="ItemType.Input" Overflow="OverflowOption.Show">
                    <Template>
                        <SfTextBox @ref="ToolbarSearchBox" Width="200px" Placeholder="Search" Type="InputType.Search" ValueChanged="SearchGrid" ShowClearButton="true" />
                    </Template>
                </ToolbarItem>
                <ToolbarItem TooltipText="Clear all grid filters" PrefixIcon="e-close icon" Visible="gridFiltered" OnClick="ClearGridFiltering" />
            </ToolbarItems>
        </SfToolbar>
        <div style="flex: 1; overflow: hidden; min-height: 0;">
            <SfGrid @ref="Grid" ID="orders-grid" DataSource="filteredOrders" AllowFiltering="true" AllowSorting="true" AllowSelection="true" Height="100%" RowHeight="25" AllowResizing="true" AutoFit="true" AllowExcelExport="true" EnableVirtualization="false">
                <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" Mode="FilterBarMode.Immediate" />
                <GridEvents OnActionBegin="ActionBeginHandler" CommandClicked="CommandClickedHandler" ExcelQueryCellInfoEvent="ExcelQueryCellInfoHandler" Filtered="GridFiltered" TValue="Order" />
                <GridSortSettings>
                    <GridSortColumns>
                        <GridSortColumn Field="Qty" Direction="Syncfusion.Blazor.Grids.SortDirection.Descending" />
                    </GridSortColumns>
                </GridSortSettings>
                <GridEditSettings AllowAdding="userService.CurrentUser.Role == UserRole.Admin"
                                  AllowEditing="userService.CurrentUser.Role == UserRole.Admin"
                                  AllowEditOnDblClick="false"
                                  AllowDeleting="userService.CurrentUser.Role == UserRole.Admin"
                                  Mode="Syncfusion.Blazor.Grids.EditMode.Dialog"
                                  Context="thisOrder">
                    <HeaderTemplate>
                        <span>@GetHeader((thisOrder as Order))</span>
                    </HeaderTemplate>
                    <Template>
                        <OrderViewEdit ThisOrder="(thisOrder as Order)" Editable="@true" CustomerList="customers" />
                    </Template>
                </GridEditSettings>
                <GridAggregates>
                    <GridAggregate>
                        <GridAggregateColumns>
                            <GridAggregateColumn Field="@nameof(Order.CustomerId)" Type="AggregateType.Count">
                                <FooterTemplate>
                                    @{
                                        var CountValue = (context as AggregateTemplateContext);
                                        <div>
                                            Count: @CountValue.Count
                                        </div>
                                    }
                                </FooterTemplate>
                            </GridAggregateColumn>
                            <GridAggregateColumn Field="@nameof(Order.Qty)" Type="AggregateType.Sum">
                                <FooterTemplate>
                                    @{
                                        var SumValue = (context as AggregateTemplateContext);
                                        <div>
                                            Sum: @($"{int.Parse(SumValue.Sum):N0}")
                                        </div>
                                    }
                                </FooterTemplate>
                            </GridAggregateColumn>
                        </GridAggregateColumns>
                    </GridAggregate>
                </GridAggregates>
                <GridColumns>
                    <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn>
                    <GridColumn Field="@nameof(Order.JobStatus)" HeaderText="Job Status" Type="ColumnType.Integer" Width="120">
                        <FilterTemplate>
                            <SfDropDownList @ref="jobStatusFilter"
                                            ID="JobStatus"
                                            DataSource="@jobStatusValues"
                                            TValue="string"
                                            TItem="string"
                                            Placeholder="Status"
                                            ShowClearButton="true"
                                            Value="@selectedStatus"
                                            PopupWidth="240">
                                <DropDownListTemplates TItem="string">
                                    <HeaderTemplate>
                                        <div style="display:flex; justify-content:space-around; padding:4px;">
                                            <button style="@GetOperatorStyle("<")" @onclick="@(() => SetOperator("<"))"> &lt; </button>
                                            <button style="@GetOperatorStyle("<=")" @onclick="@(() => SetOperator("<="))"> &lt;= </button>
                                            <button style="@GetOperatorStyle("=")" @onclick="@(() => SetOperator("="))"> = </button>
                                            <button style="@GetOperatorStyle(">=")" @onclick="@(() => SetOperator(">="))"> &gt;= </button>
                                            <button style="@GetOperatorStyle(">")" @onclick="@(() => SetOperator(">"))"> &gt; </button>
                                        </div>
                                    </HeaderTemplate>
                                </DropDownListTemplates>
                                <DropDownListEvents TItem="string" TValue="string" ValueChange="ChangeJobStatusFilter" />
                            </SfDropDownList>
                        </FilterTemplate>
                    </GridColumn>
                    <GridColumn Field="ShipMethods" Width="200" AllowSorting="false" AllowEditing="false">
                        <HeaderTemplate>
                            <div class="myflexrow">
                                <span>Ship Methods</span>
                                @if (selectedShipMethods?.Length > 0)
                                {
                                    <SfTooltip Position="Position.TopCenter" OpenDelay="800" Content="Sets filter to exclusive to only include selected methods. Default is inclusive.">
                                        <SfSwitch @bind-Checked="ShipMethodFilterExclusive" ValueChange="OnShipMethodFilterExclusiveChange" TChecked="bool" />
                                    </SfTooltip>
                                }
                            </div>
                        </HeaderTemplate>
                        <Template>

                            @{
                                var order = (context as Order);
                                {
                                    if (order.DmQty > 0)
                                    {
                                        <span class="chip-shipping chip-dm">DM</span>
                                    }
                                    if (order.UpsQty > 0)
                                    {
                                        <span class="chip-shipping chip-ups">UPS</span>
                                    }
                                    if (order.IntlQty > 0)
                                    {
                                        <span class="chip-shipping chip-intl">INTL</span>
                                    }
                                    if (order.LtlQty > 0)
                                    {
                                        <span class="chip-shipping chip-ltl">LTL</span>
                                    }
                                    if (order.PostalQty > 0)
                                    {
                                        <span class="chip-shipping chip-usps">USPS</span>
                                    }
                                }
                            }

                        </Template>
                        <FilterTemplate>
                            <SfMultiSelect TValue="string[]" TItem="string" @bind-Value="selectedShipMethods" Placeholder="Select Ship Methods" DataSource="@ShipMethodOptions">
                                <MultiSelectEvents TValue="string[]" TItem="string" ValueChange="@ShipMethodOnChange" />
                            </SfMultiSelect>
                        </FilterTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(Order.SpecialNotes)" HeaderText="Special Instructions" FilterSettings="new FilterSettings { Operator = Operator.Contains }" />
                    <GridColumn Field="@nameof(Order.CustomBP)" HeaderText="Custom BP" DisplayAsCheckBox="true" TextAlign="TextAlign.Center" Width="100" />
                    <GridColumn Field="@nameof(Order.BpUpdate)" HeaderText="BP Update" TextAlign="TextAlign.Center" Width="100" Visible="@superAdmin">
                        <Template>
                            @{
                                var order = (context as Order);

                                <SfCheckBox Checked="order.BpUpdate" CssClass="e-alert" Disabled="true" />
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(Order.YearlyBilling)" HeaderText="Yearly" TextAlign="TextAlign.Center" Width="100" Visible="@superAdmin">
                        <Template>
                            @{
                                var order = (context as Order);

                                <SfCheckBox Checked="order.YearlyBilling" EnableTriState="true" CssClass="e-alert" Disabled="true" />
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(Order.PubUsps)" HeaderText="USPS" Format="C2" TextAlign="TextAlign.Right" Width="100" Visible="@superAdmin" />
                    <GridColumn Field="@nameof(Order.PubShipping)" HeaderText="Shipping" Format="C2" TextAlign="TextAlign.Right" Width="100" Visible="@superAdmin" />
                    <GridColumn Field="@nameof(Order.CustomerId)" HeaderText="ID" Width="90" TextAlign="TextAlign.Right" />
                    <GridColumn Field="Customer.CustomerName" HeaderText="Customer" />
                    <GridColumn Field="Customer.Location" HeaderText="Location" Visible="@superAdmin" />
                    <GridColumn Field="@nameof(Order.NotesForInvoicing)" HeaderText="Notes for invoicing" Visible="@superAdmin" />
                    <GridColumn Field="@nameof(Order.Qty)" HeaderText="Quantity" Width="100" TextAlign="TextAlign.Right" Format="#,###" />
                    <GridColumn Width="155" Visible="@superAdmin">
                        <GridCommandColumns>
                            <GridCommandColumn Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-chevron-right", CssClass = "e-flat" })" ID="advance-status" />
                            <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
                            <GridCommandColumn Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-delete", CssClass = "e-flat" })" />
                        </GridCommandColumns>
                    </GridColumn>

                    <GridColumn Width="60" Visible="!superAdmin">
                        <GridCommandColumns>
                            <GridCommandColumn Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-eye", CssClass = "e-flat" })" ID="view-order" />
                        </GridCommandColumns>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
}
else
{
    <div class="myflexrow">
        <h1>Please select a user from the dropdown.</h1>
        <FluentIcon Value="@(new Icons.Regular.Size24.ArrowUpRight())" Color="Color.Neutral" />
    </div>
}


<SfDialog @ref="orderViewDialog" Visible="false" ShowCloseIcon="true" Width="50%" Header="@orderViewDialogHeader">
    <DialogTemplates>
        <Content>
            <OrderViewEdit ThisOrder="orderViewDialogRecord" Editable="false" CustomerList="customers" />
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @ref="endiciaImportDialog" Visible="false" ShowCloseIcon="true" Width="25%" Height="50%">
    <DialogEvents OnClose="RefreshOrders" />
    <DialogTemplates>
        <Content>
            <ImportEndiciaCsv ThisYear="yearQuarterService.SelectedYear" ThisQuarter="yearQuarterService.SelectedQuarter" />
        </Content>
    </DialogTemplates>
</SfDialog>

<Syncfusion.Blazor.Popups.SfDialogProvider />

<style>
    .chip-shipping {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 5px;
        height:20px;
        border-radius: 5px;
        color: white;
    }

    .chip-ups {
        background:blue;
    }

    .chip-dm {
        background:darkgrey;
    }

    .chip-usps {
        background:orange;
    }

    .chip-ltl {
        background:lightgreen;
    }

    .chip-intl {
        background:red;
    }

    .e-checkbox-wrapper.e-alert .e-frame.e-check { /* csslint allow: adjoining-classes */
        background-color: #ffff00;
        color: black
    }

    .e-gridfooter {
        height: 25px; /* adjust to whatever looks right */
    }

    .e-gridfooter.e-summarycontent{
        height: 25px; /* adjust to whatever looks right */
    }
</style>

@code {
    public SfGrid<Order> Grid { get; set; }
    public IEnumerable<Order> orders { get; set; }
    public IEnumerable<Order> filteredOrders { get; set; }
    public IEnumerable<Customer> customers { get; set; }
    public bool superAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        customers = await customerService.GetCustomersAsync();
        userService.OnUserChanged += OnUserChanged;
        yearQuarterService.OnYearQuarterChanged += YearQuarterChanged;
        RefreshOrders();
        await base.OnInitializedAsync();
    }

    private async Task RefreshOrders()
    {
        orders = await orderService.GetOrdersAsync(yearQuarterService.SelectedYear, yearQuarterService.SelectedQuarter);
        ApplyShipMethodFilter();
        await ApplyJobStatusFilter();
        StateHasChanged();
    }

    #region Job Status filter
    private SfDropDownList<string, string> jobStatusFilter;
    private SfDropDownList<string, string> jobStatusOperatorFilter;

    // Populates the status dropdown from the enum
    private List<string> jobStatusValues = Enum.GetNames(typeof(JobStatus)).ToList();

    private string selectedOperator = "=";
    private string selectedStatus = null;

    private async Task SetOperator(string op)
    {
        selectedOperator = op;
        if (string.IsNullOrEmpty(selectedStatus) || string.IsNullOrEmpty(selectedOperator))
            return;
        ApplyShipMethodFilter();
        await ApplyJobStatusFilter();
    }

    private async Task ChangeJobStatusFilter(ChangeEventArgs<string, string> args)
    {
        selectedStatus = args.Value;
        ApplyShipMethodFilter();
        await ApplyJobStatusFilter();
    }

    private string GetOperatorStyle(string op)
    {
        var active = op == selectedOperator
            ? "background-color: #0078d4; color: white;"
            : "background-color: #f0f0f0; color: black;";
        return $"border:1px solid #ccc; border-radius:4px; padding:2px 6px; cursor:pointer; font-size:12px; {active}";
    }

    private async Task ApplyJobStatusFilter()
    {
        // Don't filter if either dropdown is empty
        if (string.IsNullOrEmpty(selectedStatus) || string.IsNullOrEmpty(selectedOperator))
            return;

        // Convert the selected string name back to its int value
        var statusValue = (int)Enum.Parse<JobStatus>(selectedStatus);

        // Map your operator string to Syncfusion's Operator enum
        filteredOrders = selectedOperator switch
        {
            "<" => filteredOrders.Where(o => (int)o.JobStatus < statusValue),
            "<=" => filteredOrders.Where(o => (int)o.JobStatus <= statusValue),
            "=" => filteredOrders.Where(o => (int)o.JobStatus == statusValue),
            ">=" => filteredOrders.Where(o => (int)o.JobStatus >= statusValue),
            ">" => filteredOrders.Where(o => (int)o.JobStatus > statusValue),
            _ => filteredOrders
        };

        gridFiltered = true;
    }
    #endregion

    #region Custom Shipping methods filter
    private string[] ShipMethodOptions = new[] { "DM", "UPS", "USPS", "INTL", "LTL" };
    public bool IsFilterValueChange { get; set; }
    private bool ShipMethodFilterExclusive { get; set; } = false;

    public Syncfusion.Blazor.Grids.FilteringEventArgs filteringEvent { get; set; }

    private string[] selectedShipMethods = Array.Empty<string>();
    private async Task ShipMethodOnChange(MultiSelectChangeEventArgs<string[]> args)
    {
        selectedShipMethods = args.Value ?? Array.Empty<string>();
        ApplyShipMethodFilter();
        await ApplyJobStatusFilter();
    }

    private async Task OnShipMethodFilterExclusiveChange(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        ApplyShipMethodFilter();
        await ApplyJobStatusFilter();
    }

    private void ApplyShipMethodFilter()
    {
        // Start with all orders
        filteredOrders = orders;

        // Only filter if something is selected
        if (selectedShipMethods?.Length > 0)
        {
            gridFiltered = true;
            var localShipMethods = selectedShipMethods; //Important because Where is a deferred Linq query that can be run at a later time and if ship methods changes to null it misses that check.

            if (!ShipMethodFilterExclusive)
            {
                filteredOrders = filteredOrders.Where(o =>
                {
                    bool matches = true;

                    if (localShipMethods.Contains("DM"))
                        matches = matches && o.DmQty.HasValue && o.DmQty > 0;

                    if (localShipMethods.Contains("UPS"))
                        matches = matches && o.UpsQty.HasValue && o.UpsQty > 0;

                    if (localShipMethods.Contains("USPS"))
                        matches = matches && o.PostalQty.HasValue && o.PostalQty > 0;

                    if (localShipMethods.Contains("INTL"))
                        matches = matches && o.IntlQty.HasValue && o.IntlQty > 0;

                    if (localShipMethods.Contains("LTL"))
                        matches = matches && o.LtlQty.HasValue && o.LtlQty > 0;

                    return matches;
                });
            }
            else
            {
                filteredOrders = filteredOrders.Where(o =>
                {
                    bool matches = true;

                    // Check that selected methods HAVE quantities
                    if (localShipMethods.Contains("DM"))
                        matches = matches && o.DmQty.HasValue && o.DmQty > 0;
                    else
                        matches = matches && (!o.DmQty.HasValue || o.DmQty == 0);

                    if (localShipMethods.Contains("UPS"))
                        matches = matches && o.UpsQty.HasValue && o.UpsQty > 0;
                    else
                        matches = matches && (!o.UpsQty.HasValue || o.UpsQty == 0);

                    if (localShipMethods.Contains("USPS"))
                        matches = matches && o.PostalQty.HasValue && o.PostalQty > 0;
                    else
                        matches = matches && (!o.PostalQty.HasValue || o.PostalQty == 0);

                    if (localShipMethods.Contains("INTL"))
                        matches = matches && o.IntlQty.HasValue && o.IntlQty > 0;
                    else
                        matches = matches && (!o.IntlQty.HasValue || o.IntlQty == 0);

                    if (localShipMethods.Contains("LTL"))
                        matches = matches && o.LtlQty.HasValue && o.LtlQty > 0;
                    else
                        matches = matches && (!o.LtlQty.HasValue || o.LtlQty == 0);

                    return matches;
                });
            }
        }
    }
    #endregion

    #region Datagrid Handlers
    private async Task ActionBeginHandler(ActionEventArgs<Order> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
        {
            if (args.Action == "Add")
            {
                args.Cancel = true;
                if (args.Data.Customer == null)
                {
                    await orderService.GenerateOrders(null, args.Data.Year, args.Data.Quarter);
                }
                else
                {
                    await orderService.GenerateOrders(args.Data.Customer.CustomerId, args.Data.Year, args.Data.Quarter);
                }
                RefreshOrders();
            }
            else if (args.Action == "Edit")
            {
                args.Cancel = true;
                await orderService.UpdateOrderAsync(args.Data);
                RefreshOrders();
            }
        }
        else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            args.Cancel = true;
            DeleteOrderAsync(args.Data);
        }
    }

    private async Task DeleteOrderAsync(Order order)
    {
        bool isConfirm = await DialogService.ConfirmAsync("Are you sure you want to permanently delete this order? This action cannot be undone", "Delete");
        if (isConfirm)
        {
            await orderService.DeleteOrderAsync(order);
            RefreshOrders();
        }
    }

    private async Task ActionCompleteHandler(ActionEventArgs<Order> args)
    {
        await RefreshOrders();
    }

    public async void CommandClickedHandler(CommandClickEventArgs<Order> args)
    {
        if (args.CommandColumn.Type == CommandButtonType.Edit)
        {
            ActionEventArgs<Order> actionEventArgs = new ActionEventArgs<Order>();
            actionEventArgs.Data = args.RowData;
            ActionBeginHandler(actionEventArgs);
        }
        else if (args.CommandColumn.Type == CommandButtonType.Delete)
        {
            ActionEventArgs<Order> actionEventArgs = new ActionEventArgs<Order>();
            actionEventArgs.Data = args.RowData;
            ActionBeginHandler(actionEventArgs);
        }
        else if (args.CommandColumn.Type == CommandButtonType.None)
        {
            args.Cancel = true;
            if (args.CommandColumn.ID == "view-order")
            {
                orderViewDialogRecord = args.RowData;
                orderViewDialogHeader = "Order details of " + orderViewDialogRecord.Customer.CustomerName;
                orderViewDialog.ShowAsync();
            }
            else if (args.CommandColumn.ID == "advance-status")
            {
                args.RowData.JobStatus = (JobStatus)((int)args.RowData.JobStatus + 1);
                await orderService.UpdateOrderAsync(args.RowData);
                await RefreshOrders();
            }
        }
    }

    public void ExcelQueryCellInfoHandler(ExcelQueryCellInfoEventArgs<Order> args)
    {
        if (args.Column.Field == "ShipMethods")
        {
            string shipMethodsString = "";
            if (args.Data.DmQty.HasValue && args.Data.DmQty > 0)
            {
                shipMethodsString = "DM";
            }
            if (args.Data.LtlQty.HasValue && args.Data.LtlQty > 0)
            {
                if (shipMethodsString == "")
                {
                    shipMethodsString = "LTL";
                }
                else
                {
                    shipMethodsString = shipMethodsString + " + LTL";
                }
            }
            if (args.Data.UpsQty.HasValue && args.Data.UpsQty > 0)
            {
                if (shipMethodsString == "")
                {
                    shipMethodsString = "UPS";
                }
                else
                {
                    shipMethodsString = shipMethodsString + " + UPS";
                }
            }
            if (args.Data.IntlQty.HasValue && args.Data.IntlQty > 0)
            {
                if (shipMethodsString == "")
                {
                    shipMethodsString = "INTL";
                }
                else
                {
                    shipMethodsString = shipMethodsString + " + INTL";
                }
            }
            if (args.Data.PostalQty.HasValue && args.Data.PostalQty > 0)
            {
                if (shipMethodsString == "")
                {
                    shipMethodsString = "USPS";
                }
                else
                {
                    shipMethodsString = shipMethodsString + " + USPS";
                }
            }
            args.Cell.Value = shipMethodsString;
        }
    }

    public string GetHeader(Order arg)
    {
        return arg.OrderId == Guid.Empty
            ? "Add New Order"
            : "Edit the " + arg.Year + " " + arg.Quarter + " order of " + arg.Customer.CustomerName;
    }

    private bool gridFiltered = false;
    private async Task ClearGridFiltering()
    {
        Grid.ClearFilteringAsync();
        selectedShipMethods = Array.Empty<string>();
        //Job status filters
        selectedOperator = "=";
        selectedStatus = null;

        filteredOrders = orders;
        gridFiltered = false;
        ShipMethodFilterExclusive = false;
    }
    private async Task GridFiltered()
    {
        gridFiltered = true;
    }
    #endregion

    #region Toolbar
    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Text == "Add")
        {
            Grid.AddRecordAsync();
        }
        else if (args.Item.Text == "CSV Export")
        {
            ExcelExportProperties ExportProperties = new ExcelExportProperties
            {
                IncludeTemplateColumn = true,
                IncludeHiddenColumn = true,
                IncludeCommandColumn = false
            };
            await Grid.ExportToCsvAsync(ExportProperties);
        }
        else if (args.Item.Text == "Saddle Stitched")
        {
            if (userService.CurrentUser.Role == UserRole.Duplo)
            {
                var selectedOrders = await Grid.GetSelectedRecordsAsync();
                foreach (var order in selectedOrders)
                {
                    order.JobStatus = JobStatus.ReadyToShip;
                    await orderService.UpdateOrderAsync(order);
                }
                RefreshOrders();
            }
            Grid.ClearRowSelectionAsync();
        }
        else if (args.Item.Text == "Assign Plates")
        {
            plateService.AssignJobsToPlatesAsync(orders);
        }
        else if (args.Item.Text == "Import Endicia")
        {
            endiciaImportDialog.ShowAsync();
        }
    }

    public SfTextBox ToolbarSearchBox;
    private async Task SearchGrid()
    {
        Grid.SearchAsync(ToolbarSearchBox.Value);
    }
    #endregion

    #region Dialog handlers
    private SfDialog orderViewDialog;
    private string orderViewDialogHeader;
    private Order orderViewDialogRecord;

    private SfDialog endiciaImportDialog;
    #endregion

    private async void OnUserChanged()
    {
        StateHasChanged();
    }

    private async void YearQuarterChanged()
    {
        await RefreshOrders();
    }

    public void Dispose()
    {
        userService.OnUserChanged -= OnUserChanged;
        yearQuarterService.OnYearQuarterChanged -= YearQuarterChanged;
    }

}
