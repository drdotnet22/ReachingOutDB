@using ReachingOutDB.Data
@using System.Data

@inject OrderServices orderService
@inject IWebHostEnvironment env

<div class="myflexcolumn">
        <SfUploader ID="upload-endicia" AllowedExtensions=".csv" AllowMultiple="false" >
            <UploaderEvents ValueChange="OnChange" OnRemove="OnRemove"></UploaderEvents>
        </SfUploader>

        <SfButton @onclick="ProcessCsv" Disabled="!fileExists">Process CSV file</SfButton>

        <pre>@responseMessage</pre>
</div>

@code {
    [Parameter] public int ThisYear { get; set; }

    [Parameter] public Quarter ThisQuarter { get; set; }

    private string path;
    private string responseMessage = " ";
    private bool fileExists = false;
    protected override async Task OnInitializedAsync()
    {
        path = $"{env.WebRootPath}\\Data\\EndiciaImport.csv";
        fileExists = File.Exists(path);
    }

    private async void ProcessCsv()
    {
        responseMessage = await orderService.ImportEndiciaPrintLogCsvAsync(path, ThisYear, ThisQuarter);
        StateHasChanged();
    }

    private async Task OnChange(UploadChangeEventArgs args)
    {
        try
        {
            foreach (var file in args.Files)
            {
                FileStream fs = new FileStream(path, FileMode.Create, FileAccess.Write);
                await file.File.OpenReadStream(long.MaxValue).CopyToAsync(fs);
                fs.Close();
            }
            fileExists = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void OnRemove(RemovingEventArgs args)
    {
        foreach (var removeFile in args.FilesData)
        {
            if (File.Exists(path))
            {
                File.Delete(path);
            }
            fileExists = false;
        }
    }
}
