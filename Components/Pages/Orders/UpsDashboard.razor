@page "/upsdashboard"

@using ReachingOutDB.Data
@using ReachingOutDB.Components.Shared
@inject OrderServices orderService
@inject CustomerServices customerService
@rendermode InteractiveServer
<PageTitle>UPS - Reaching Out</PageTitle>

<div class="myflexrow">
    <YearQuarterSelector @bind-SelectedYear="selectedYear" @bind-SelectedQuarter="selectedQuarter" />
    <SfButton IconCss="e-icons e-refresh" CssClass="e-small e-round" OnClick="RefreshOrders"></SfButton>
</div>
<br />
<div class="myflexcolumn">
    <SfGrid @ref="Grid" DataSource="upsOrders" RowHeight="25" Width="1200" Toolbar="@ToolbarItems">
        <GridEvents OnToolbarClick="ToolbarClickHandler" TValue="Order" />
        <GridColumns>
            <GridForeignColumn Field="@nameof(Order.CustomerId)" ForeignKeyValue="CustomerId" ForeignDataSource="@customers" HeaderText="Customer ID" Width="110" TextAlign="TextAlign.Right" />
            <GridForeignColumn Field="@nameof(Order.CustomerId)" ForeignDataSource="@customers" ForeignKeyValue="CustomerName" HeaderText="Customer" Width="300"/>
            <GridColumn Field="@nameof(Order.Qty)" HeaderText="Total Order Qty" Format="#,###" Width="150" TextAlign="TextAlign.Right"/>
            <GridColumn Field="@nameof(Order.UpsQty)" HeaderText="UPS Qty" Format="#,###" Width="150" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(Order.UpsCost)" HeaderText="UPS Cost" Format="C2" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(Order.PubShipping)" HeaderText="Published Shipping" Format="C2" TextAlign="TextAlign.Right" />
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @ref="upsCostDialog" Visible="false" Width="700" ShowCloseIcon="true" AllowDragging="true" IsModal="true" >
    <DialogTemplates>
        <Header>Enter UPS Cost</Header>
        <Content>
            <UpsCostInput orders="upsOrders" />
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    public SfGrid<Order> Grid { get; set; }
    public IEnumerable<Order> orders { get; set; }
    public IEnumerable<Order> upsOrders { get; set; }
    public IEnumerable<Customer> customers { get; set; }
    public int selectedYear { get; set; }
    public Quarter selectedQuarter { get; set; }
    private List<Object> ToolbarItems = new List<Object>() { new ItemModel() { Text = "Refresh Grid", TooltipText = "Refresh the datagrid.", PrefixIcon = "e-refresh icon" }, new ItemModel() { Text = "Cost Input", TooltipText = "Enter cost of UPS shipment", PrefixIcon = "e-check-box icon" }, "Search" };

    protected override async Task OnInitializedAsync()
    {
        customers = await customerService.GetCustomersAsync();
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshOrders();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task RefreshOrders()
    {
        orders = await orderService.GetOrdersAsync(selectedYear, selectedQuarter);
        upsOrders = orders.Where(o => o.UpsQty.HasValue && o.UpsQty > 0 && (JobStatus)((int)o.JobStatus) <= (JobStatus)((int)JobStatus.Shipped));
        StateHasChanged();
    }

    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Text == "Refresh Grid")
        {
            await RefreshOrders();
            Grid.ClearRowSelectionAsync();
        }
        else if (args.Item.Text == "Cost Input")
        {
            upsCostDialog.ShowAsync();
        }
    }

    private SfDialog upsCostDialog;

    public void CloseUPSDialog(string action)
    {
        this.upsCostDialog.Visible = false;
    }
}
