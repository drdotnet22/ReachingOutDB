@using ReachingOutDB.Data
@inject AuditLogServices auditLogServices


<SfGrid DataSource="@auditLogs" TValue="OrderAuditLog">
    <GridColumns>
        <GridColumn Field="@nameof(OrderAuditLog.Timestamp)" >
            <Template>
                @ToNewYorkTime((context as OrderAuditLog).Timestamp)
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(OrderAuditLog.UserName)" />
        <GridColumn Field="@nameof(OrderAuditLog.Action)" />
        <GridColumn Field="@nameof(OrderAuditLog.PropertyName)" />
        <GridColumn Field="@nameof(OrderAuditLog.OldValue)" />
        <GridColumn Field="@nameof(OrderAuditLog.NewValue)" />
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public Order ThisOrder { get; set; }
    public IEnumerable<OrderAuditLog> auditLogs { get; set; }

    protected override async Task OnInitializedAsync()
    {
        auditLogs = await auditLogServices.GetLogsOfOrder(ThisOrder);
        await base.OnInitializedAsync();
    }

    private string ToNewYorkTime(DateTime utcTime)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
        var nyTime = TimeZoneInfo.ConvertTimeFromUtc(utcTime, tz);
        return nyTime.ToString("M/d/yyyy hh:mm tt");
    }
}
