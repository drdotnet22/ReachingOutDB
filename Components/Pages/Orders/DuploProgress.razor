@using Syncfusion.Blazor.LinearGauge
@using ReachingOutDB.Data
@inject OrderStateServices orderStateServices
@implements IDisposable

<SfLinearGauge Orientation="Syncfusion.Blazor.LinearGauge.Orientation.Horizontal" Background="transparent" Width="500" >
    <LinearGaugeContainer Width="25" RoundedCornerRadius="20" Type="ContainerType.Normal">
        <LinearGaugeContainerBorder Width="1" Color="#3D3D3D" />
        <LinearGaugeAxes>
            <LinearGaugeAxis Minimum="0" Maximum="100">
                <LinearGaugeLine Width="0" />
                <LinearGaugeMajorTicks Interval="10" Height="0" />
                <LinearGaugeMinorTicks Interval="1" Height="0" />
                <LinearGaugeAxisLabelStyle>
                    <LinearGaugeAxisLabelFont Size="0"></LinearGaugeAxisLabelFont>
                </LinearGaugeAxisLabelStyle>
                <LinearGaugePointers>
                    <LinearGaugePointer PointerValue="@currentProgress.DuploProgressPercentage" Height="25" Width="25" Type="Point.Bar" Color="#62CC87" />
                </LinearGaugePointers>
                <LinearGaugeAnnotations>
                    <LinearGaugeAnnotation AxisIndex="0" AxisValue="12" X="0" Y="0" ZIndex="1">
                        <ContentTemplate>
                            <div style="font-size: 13px;color: black;margin-top: 3px;">Assembled @currentProgress.AssembledOrders.ToString("N0") of @currentProgress.TotalOrders.ToString("N0") - @currentProgress.DuploProgressPercentage% complete</div>
                        </ContentTemplate>
                    </LinearGaugeAnnotation>
                </LinearGaugeAnnotations>
            </LinearGaugeAxis>
        </LinearGaugeAxes>
    </LinearGaugeContainer>
</SfLinearGauge>

@code {
    [Parameter]
    public string QuarterKey { get; set; } = string.Empty;

    private QuarterlyProgress currentProgress;

    protected override async Task OnInitializedAsync()
    {
        orderStateServices.OnDuploProgressUpdated += DuploProgressUpdated;
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        currentProgress = orderStateServices.GetProgressForQuarter(QuarterKey);
        await base.OnParametersSetAsync();
    }

    private async Task DuploProgressUpdated(string quarterKey)
    {
        // Only UI re-render if the updated data belongs to THIS component's quarter
        if (string.Equals(quarterKey, QuarterKey, StringComparison.OrdinalIgnoreCase))
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        orderStateServices.OnDuploProgressUpdated -= DuploProgressUpdated;
    }
}
