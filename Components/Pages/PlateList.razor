@page "/platelist"

@using ReachingOutDB.Data
@using ReachingOutDB.Components.Shared

@inject PlateServices plateService
@inject OrderServices orderService
@rendermode InteractiveServer

<div class="myflexrow">
    <YearQuarterSelector @bind-SelectedYear="selectedYear" @bind-SelectedQuarter="selectedQuarter" />
    <SfButton IconCss="e-icons e-refresh" CssClass="e-small e-round" OnClick="RefreshPlates"></SfButton>
</div>
<br />


@if (filteredPlates != null)
{

    <span>Blank plates needed: @blanksNeeded</span>
    <span>Blank sheets plated: @blankSheets</span><br/>
    <span>Efficiency: @efficiency.ToString("P1")</span>
    <h3>PlateList</h3>
    <div class="card-container">
        @foreach (var plate in filteredPlates)
        {
            <SfCard style="@(plate.IsPlated ? "background-color: #e9ecef;" : "")"
                    class="@(plate.IsPlated ? "plated-card e-card" : "e-card")">
                <CardContent>
                    <div class="myflexrow" style="align-items:center">
                        <h5>Plate #: @(plate.Number + 1) with @plate.Quantity sheets needed.</h5>
                        @if (plate.IsPlated)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size24.CheckmarkCircle())" Color="Color.Success" />
                        }
                        else
                        {
                            <FluentButton Title="Plate Order" OnClick="() => PlateOrder(plate)">
                                <FluentIcon Value="@(new Icons.Regular.Size24.Checkmark())" Color="Color.Accent"/>
                            </FluentButton>
                            <FluentButton Title="Edit Plate (Not implemented)" >
                                <FluentIcon Value="@(new Icons.Regular.Size24.Edit())" Color="Color.Neutral"  />
                            </FluentButton>
                        }
                        <FluentButton Title="Delete Plate" OnClick="() => DeletePlate(plate)">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Delete())" Color="Color.Error" />
                        </FluentButton>
                    </div>
                    <SfGrid DataSource="plate.PlateAssignments" AllowSorting="true" RowHeight="20" >
                        <GridSortSettings>
                            <GridSortColumns>
                                <GridSortColumn Field="Position" Direction="Syncfusion.Blazor.Grids.SortDirection.Ascending" />
                            </GridSortColumns>
                        </GridSortSettings>
                        <GridColumns>
                            <GridColumn HeaderText="Position" Field="@nameof(PlateAssignment.Position)" TextAlign="TextAlign.Right" Width="100"/>
                            <GridColumn HeaderText="Customer">
                                <Template>
                                    @{
                                        var assignment = (context as PlateAssignment);
                                        {
                                            if (assignment.OrderId != null)
                                            {
                                                <span>@assignment.Order.CustomerId.ToString() - @assignment.Order.Customer.CustomerName</span>
                                            }
                                            else
                                            {
                                                <span>Blank</span>
                                            }
                                        }
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Quantity" TextAlign="TextAlign.Right">
                                <Template>
                                    @{
                                        var assignment = (context as PlateAssignment);
                                        {
                                            if (assignment.OrderId != null)
                                            {
                                                <span>@assignment.Order.Qty</span>
                                            }
                                            else
                                            {
                                                <span>@plate.Quantity</span>
                                            }
                                        }
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </CardContent>
            </SfCard>
        }
    </div>
}
else
{
    <span>No plates to list.</span>
}
@code {
    public int selectedYear { get; set; }
    public int blankSheets { get; set; }
    public int blanksNeeded { get; set; }
    public int platedOrderTotal { get; set; }
    public double efficiency { get; set; }
    public Quarter selectedQuarter { get; set; }
    public IEnumerable<Plate> filteredPlates { get; set; }
    public IEnumerable<Order> unplatedOrders { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshPlates();
        await base.OnInitializedAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshPlates();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task RefreshPlates()
    {
        IEnumerable<Order> orders = await orderService.GetOrdersIncludePlateAssignmentsAsync(selectedYear, selectedQuarter);
        blanksNeeded = orders
            .Where(o => o.Qty < 1000)
            .Where(o => !o.PlateAssignments.Any())
            .Sum(o => o.Qty);

        platedOrderTotal = orders
            .Where(o => o.PlateAssignments.Any())
            .Sum(o => o.Qty);


        filteredPlates = await plateService.GetFilteredPlatesAsync(selectedYear, selectedQuarter);
        blankSheets = filteredPlates
            .SelectMany(p => p.PlateAssignments)
            .Where(pa => pa.IsBlank == true)
            .Sum(pa => pa.Plate.Quantity);

        int platedQty = filteredPlates.Sum(p => p.Quantity);

        efficiency = ((double)(blanksNeeded + 2000 + platedOrderTotal)) / (platedQty * 4);
        StateHasChanged();
    }

    public async Task PlateOrder(Plate plate)
    {
        await plateService.MarkPlatedAsync(plate);
        await RefreshPlates();
    }

    public async Task DeletePlate(Plate plate)
    {
        await plateService.DeletePlateAsync(plate);
        await RefreshPlates();
    }
}

<style>
    .card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 16px; /* Adjust spacing between cards as needed */
    }

    .card-container .e-card {
        flex: 0 0 calc(50% - 8px); /* 50% width minus half the gap */
        box-sizing: border-box;
    }

    .plated-card .e-grid .e-headercell,
    .plated-card .e-grid .e-row .e-rowcell,
    .plated-card .e-grid .e-altrow .e-rowcell {
        background-color: #e9ecef !important;
    }

    
    .e-grid .e-table {
        margin-bottom: 0 !important;
    }
</style>
