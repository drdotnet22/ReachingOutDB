@using ReachingOutDB.Data
@inject CustomerChangesServices customerChangesServices
@inject DateTimeUtilities utilities

<SfGrid DataSource="@changeLogs" TValue="CustomerChangesLog">
    <GridEvents TValue="CustomerChangesLog" CommandClicked="CommandClickedHandler"/>
    <GridColumns>
        <GridColumn Field="@nameof(CustomerChangesLog.Timestamp)">
            <Template>
                @utilities.ToNewYorkTimeString((context as CustomerChangesLog).Timestamp)
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(CustomerChangesLog.UserName)" />
        <GridColumn Field="@nameof(CustomerChangesLog.Contact)" />
        <GridColumn Field="@nameof(CustomerChangesLog.Notes)" />
        <GridColumn Field="@nameof(CustomerChangesLog.ScanContent)" >
            <Template>
                @{
                    var log = (context as CustomerChangesLog);
                    bool hasScan = log.ScanContent != null && log.ScanContent.Length > 0;
                    <SfCheckBox Checked="hasScan" Disabled="true" />
                }
            </Template>
        </GridColumn>
        <GridColumn Width="60">
            <GridCommandColumns>
                <GridCommandColumn Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-eye", CssClass = "e-flat" })" ID="view-order" />
            </GridCommandColumns>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @ref="customerChangeLogViewDialog" Visible="false" ShowCloseIcon="true" IsModal="true" Width="60%">
    <DialogTemplates>
        <Content>
            <CustomerChangesLogViewEdit ThisLog="@selectedChangeLog" Editable="false" />
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Customer ThisCustomer { get; set; }
    public IEnumerable<CustomerChangesLog> changeLogs { get; set; }

    private SfDialog customerChangeLogViewDialog;
    private CustomerChangesLog selectedChangeLog;

    protected override async Task OnInitializedAsync()
    {
        changeLogs = await customerChangesServices.GetCustomerChangesLogsAsync(ThisCustomer.CustomerId);
        await base.OnInitializedAsync();
    }

    private async void CommandClickedHandler(CommandClickEventArgs<CustomerChangesLog> args)
    {
        if (args.CommandColumn.ID == "view-order")
        {
            selectedChangeLog = args.RowData;
            customerChangeLogViewDialog.ShowAsync();
        }
    }

    private void CustomerLogViewDialogClosed()
    {
        selectedChangeLog = null;
    }
}
