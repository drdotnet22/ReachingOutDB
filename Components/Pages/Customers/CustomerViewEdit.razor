@using ReachingOutDB.Data


<div class="myflexcolumn">
    <SfCard>
        <CardContent>
            <div class="myflexrow">
                <SfNumericTextBox ID="CustomerId" @bind-Value="@ThisCustomer.CustomerId" Placeholder="Number" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Format="####" Enabled="ThisCustomer.CustomerId == 0" Width="250px" />
                <SfTextBox ID="CustomerName" @bind-Value="@(ThisCustomer.CustomerName)" Placeholder="Customer Name" FloatLabelType="FloatLabelType.Always" Readonly="@(!Editable)"/>
                <SfTextBox ID="CustomerLocation" @bind-Value="@(ThisCustomer.Location)" Placeholder="Customer Location" FloatLabelType="FloatLabelType.Always" Readonly="@(!Editable)" />
            </div>
        </CardContent>
    </SfCard>
    @if (ThisCustomer.VariableOrders)
    {
        <SfCard>
            <CardContent>
                <div class="myflexrow">
                    <SfNumericTextBox ID="QtyQ1" @bind-Value="@(ThisCustomer.QtyQ1)" Placeholder="Quantity Q1" FloatLabelType="FloatLabelType.Always" Width="100px" ShowSpinButton="false" Readonly="true" />
                    <SfTextArea @bind-Value="@(ThisCustomer.NotesQ1)" Placeholder="Notes for Q1" RowCount="1" ColumnCount="100" FloatLabelType="FloatLabelType.Always" ResizeMode="Syncfusion.Blazor.Inputs.Resize.Vertical" Readonly="@(!Editable)" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox ID="QtyQ1" @bind-Value="@(ThisCustomer.QtyQ2)" Placeholder="Quantity Q2" FloatLabelType="FloatLabelType.Always" Width="100px" ShowSpinButton="false" Readonly="true" />
                    <SfTextArea @bind-Value="@(ThisCustomer.NotesQ2)" Placeholder="Notes for Q2" RowCount="1" ColumnCount="100" FloatLabelType="FloatLabelType.Always" ResizeMode="Syncfusion.Blazor.Inputs.Resize.Vertical" Readonly="@(!Editable)" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox ID="QtyQ1" @bind-Value="@(ThisCustomer.QtyQ3)" Placeholder="Quantity Q3" FloatLabelType="FloatLabelType.Always" Width="100px" ShowSpinButton="false" Readonly="true" />
                    <SfTextArea @bind-Value="@(ThisCustomer.NotesQ3)" Placeholder="Notes for Q3" RowCount="1" ColumnCount="100" FloatLabelType="FloatLabelType.Always" ResizeMode="Syncfusion.Blazor.Inputs.Resize.Vertical" Readonly="@(!Editable)" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox ID="QtyQ1" @bind-Value="@(ThisCustomer.QtyQ4)" Placeholder="Quantity Q4" FloatLabelType="FloatLabelType.Always" Width="100px" ShowSpinButton="false" Readonly="true" />
                    <SfTextArea @bind-Value="@(ThisCustomer.NotesQ4)" Placeholder="Notes for Q4" RowCount="1" ColumnCount="100" FloatLabelType="FloatLabelType.Always" ResizeMode="Syncfusion.Blazor.Inputs.Resize.Vertical" Readonly="@(!Editable)" />
                </div>
            </CardContent>
        </SfCard>
    }
    else
    {
        <SfCard>
            <CardContent>
                <div class="myflexrow">
                    <SfNumericTextBox ID="Qty" @bind-Value="@(ThisCustomer.Qty)" Placeholder="Quantity" FloatLabelType="FloatLabelType.Always" Width="100px" ShowSpinButton="false" Readonly="true" />
                    <SfTextArea @bind-Value="@(ThisCustomer.Notes)" Placeholder="Notes" RowCount="1" ColumnCount="100" FloatLabelType="FloatLabelType.Always" ResizeMode="Syncfusion.Blazor.Inputs.Resize.Vertical" Readonly="@(!Editable)" />
                </div>
            </CardContent>
        </SfCard>
    }

    <SfCheckBox @bind-Checked="@(ThisCustomer.Active)" Label="Active Customer" Disabled="@(!Editable)"/>
    <SfCheckBox @bind-Checked="@(ThisCustomer.VariableOrders)" Label="Variable Quantity" Disabled="@(!Editable)" />
    <SfCheckBox @bind-Checked="@(ThisCustomer.CustomBP)" Label="Custom Back Page" Disabled="@(!Editable)" />
    <SfCheckBox @bind-Checked="@(ThisCustomer.BackpageUpdates)" Label="Regular backpage updates" Disabled="@(!Editable)" />
    <SfCheckBox @bind-Checked="@(ThisCustomer.SpecialNoteUPS)" Label="Special Notes for UPS shipping" Disabled="@(!Editable)" />
    <SfDropDownList TItem="string" TValue="Quarter?"
                    @bind-Value="@ThisCustomer.YearlyBillingQuarter"
                    DataSource="@quarterValues"
                    Placeholder="Billing Quarter"
                    FloatLabelType="FloatLabelType.Always"
                    ShowClearButton="true" 
                    Readonly="@(!Editable)">
    </SfDropDownList>
    @if (ThisCustomer.VariableOrders)
    {
        <div class="myflexrow">
            <SfCard>
                <CardHeader Title="Variable Direct Mail Quantity" />
                <CardContent>
                    <SfNumericTextBox ID="DmQtyQ1" @bind-Value="@(ThisCustomer.DmQtyQ1)" Placeholder="Q1 Direct Mail Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="DmQtyQ2" @bind-Value="@(ThisCustomer.DmQtyQ2)" Placeholder="Q2 Direct Mail Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="DmQtyQ3" @bind-Value="@(ThisCustomer.DmQtyQ3)" Placeholder="Q3 Direct Mail Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="DmQtyQ4" @bind-Value="@(ThisCustomer.DmQtyQ4)" Placeholder="Q4 Direct Mail Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </CardContent>
            </SfCard>
            <SfCard>
                <CardHeader Title="Variable UPS Quantity" />
                <CardContent>
                    <SfNumericTextBox ID="UpsQtyQ1" @bind-Value="@(ThisCustomer.UpsQtyQ1)" Placeholder="Q1 UPS Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="UpsQtyQ2" @bind-Value="@(ThisCustomer.UpsQtyQ2)" Placeholder="Q2 UPS Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="UpsQtyQ3" @bind-Value="@(ThisCustomer.UpsQtyQ3)" Placeholder="Q3 UPS Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="UpsQtyQ4" @bind-Value="@(ThisCustomer.UpsQtyQ4)" Placeholder="Q4 UPS Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </CardContent>
            </SfCard>
            <SfCard>
                <CardHeader Title="Variable Postal Quantity" />
                <CardContent>
                    <SfNumericTextBox ID="PostalQtyQ1" @bind-Value="@(ThisCustomer.PostalQtyQ1)" Placeholder="Q1 Postal Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="PostalQtyQ2" @bind-Value="@(ThisCustomer.PostalQtyQ2)" Placeholder="Q2 Postal Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="PostalQtyQ3" @bind-Value="@(ThisCustomer.PostalQtyQ3)" Placeholder="Q3 Postal Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="PostalQtyQ4" @bind-Value="@(ThisCustomer.PostalQtyQ4)" Placeholder="Q4 Postal Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </CardContent>
            </SfCard>
            <SfCard>
                <CardHeader Title="Variable Truck Line Quantity" />
                <CardContent>
                    <SfNumericTextBox ID="LtlQtyQ1" @bind-Value="@(ThisCustomer.LtlQtyQ1)" Placeholder="Q1 LTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="LtlQtyQ2" @bind-Value="@(ThisCustomer.LtlQtyQ2)" Placeholder="Q2 LTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="LtlQtyQ3" @bind-Value="@(ThisCustomer.LtlQtyQ3)" Placeholder="Q3 LTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="LtlQtyQ4" @bind-Value="@(ThisCustomer.LtlQtyQ4)" Placeholder="Q4 LTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </CardContent>
            </SfCard>
            <SfCard>
                <CardHeader Title="Variable International Quantity" />
                <CardContent>
                    <SfNumericTextBox ID="IntlQtyQ1" @bind-Value="@(ThisCustomer.IntlQtyQ1)" Placeholder="Q1 INTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="IntlQtyQ2" @bind-Value="@(ThisCustomer.IntlQtyQ2)" Placeholder="Q2 INTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="IntlQtyQ3" @bind-Value="@(ThisCustomer.IntlQtyQ3)" Placeholder="Q3 INTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                    <SfNumericTextBox ID="IntlQtyQ4" @bind-Value="@(ThisCustomer.IntlQtyQ4)" Placeholder="Q4 INTL Quantity" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </CardContent>
            </SfCard>
        </div>
    } 
    else
    {
        <SfCard>
            <CardHeader Title="Quarterly Quantities" />
            <CardContent>
                <div class="myflexrow">
                    <SfNumericTextBox ID="DMQty" @bind-Value="@(ThisCustomer.DmQty)" Placeholder="Quantity by direct mail" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox ID="UpsQty" @bind-Value="@(ThisCustomer.UpsQty)" Placeholder="Quantity by UPS" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox ID="PostalQty" @bind-Value="@(ThisCustomer.PostalQty)" Placeholder="Quantity by Postal" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </div>
                <div class="myflexrow">
                    <SfNumericTextBox ID="IntlQty" @bind-Value="@(ThisCustomer.IntlQty)" Placeholder="Quantity by INTL" FloatLabelType="FloatLabelType.Always" ShowSpinButton="false" Readonly="@(!Editable)" />
                </div>
            </CardContent>
        </SfCard>
    }

    @if (ThisCustomer.MailingNotes != null)
    {
        <SfAccordion>
            <AccordionItems>
                <AccordionItem Expanded="@mailingNotesExpanded">
                    <HeaderTemplate>Mailing Notes</HeaderTemplate>
                    <ContentTemplate>
                        <MailingNotesEditor SelectedCustomer="ThisCustomer" Editable="@(Editable)" />
                    </ContentTemplate>
                </AccordionItem>
            </AccordionItems>
        </SfAccordion>
    }
    else
    {
        <SfButton OnClick="AddMailingNotes" Disabled="@(!Editable)">Add Mailing Notes</SfButton>
    }

    <SfCard>
        <CardHeader Title="Customer change logs" />
        <CardContent>
            <CustomerChangesLogList ThisCustomer="ThisCustomer" />
        </CardContent>
    </SfCard>

</div>

@code {
    [Parameter] public Customer ThisCustomer { get; set; }
    [Parameter] public bool Editable { get; set; }

    public string[] quarterValues = Quarter.GetNames(typeof(Quarter));
    private bool mailingNotesExpanded = false;

    private async Task AddMailingNotes()
    {
        ThisCustomer.MailingNotes = "";
        mailingNotesExpanded = true;
    }
}