@page "/customercsvupload"
@using ReachingOutDB.Data
@using System.IO
@using Sylvan.Data.Csv
@inject CustomerServices customerService
@inject IWebHostEnvironment env
@rendermode InteractiveServer

<div class="content-wrapper">
    <div class="row">
        <SfButton @onclick="ProcessCSV" >Process CSV file</SfButton>
    </div>
</div>
@code {
    private string path;
    protected override async Task OnInitializedAsync()
    {
        path = $"{env.WebRootPath}\\Data\\ReachingOutCustomers.csv";
    }

    private async void ProcessCSV()
    {
        await customerService.InitialImportFromCSV(path);
    }
}
