@page "/customers"
@using ReachingOutDB.Components.Pages.Orders
@using ReachingOutDB.Data
@using Microsoft.EntityFrameworkCore
@inject OrderServices orderService
@inject CustomerServices customerService
@inject UserServices userService
@inject CustomerChangesServices customerChangesServices
@inject NavigationManager navigationManager

<PageTitle>Customers - Reaching Out</PageTitle>

<div class="flexrow" >
    <h3 style="width:200px">Customers</h3>
    <div>
        <label style="padding: 10px 10px 10px 0">Show Archived Customers</label>
        <SfSwitch @bind-Checked="showArchivedCustomers" ValueChange="ChangeCustomerFilter" TChecked="bool" />
    </div>
</div>
<SfGrid @ref="Grid" DataSource="@filteredCustomers" Toolbar="@ToolbarItems" AllowSorting="true" AllowResizing="true" RowHeight="30">
    <GridEvents OnActionBegin="ActionBeginHandler" TValue="Customer" />
    <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="Syncfusion.Blazor.Grids.EditMode.Dialog" >
        <HeaderTemplate>
            @{
                var dialogHeader = GetHeader((context as Customer));
                <span>@dialogHeader</span>
            }
        </HeaderTemplate>
        <Template>
            <CustomerViewEdit ThisCustomer="(context as Customer)" Editable="true" />
         </Template>
    </GridEditSettings>
    <GridColumns>
        <GridColumn HeaderText="ID" Field="CustomerId" IsPrimaryKey="true" Type="ColumnType.Integer" Width="100" TextAlign="TextAlign.Right"/>
        <GridColumn HeaderText="Customer Name" Field="CustomerName" Type="ColumnType.String" TextAlign="TextAlign.Left" />
        <GridColumn HeaderText="Location" Field="Location" Type="ColumnType.String" TextAlign="TextAlign.Left" />
        <GridColumn HeaderText="Quantity" Field="Qty" Type="ColumnType.Integer" TextAlign="TextAlign.Right" Width="90">
            <Template>
                @if ((context as Customer).VariableOrders == false)
                {
                    @((context as Customer).Qty?.ToString("N0"))
                }
                else
                {
                    <text>--</text>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Variable Qty" Field="VariableOrders" TextAlign="TextAlign.Center" DisplayAsCheckBox="true" />
        <GridColumn HeaderText="Customer BP" Field="CustomBP" TextAlign="TextAlign.Center" DisplayAsCheckBox="true"/>
        <GridColumn HeaderText="Backpage Updates" Field="BackpageUpdates" TextAlign="TextAlign.Center" DisplayAsCheckBox="true" />
        <GridColumn HeaderText="Active" Field="Active" TextAlign="TextAlign.Center" DisplayAsCheckBox="true" Visible="@showArchivedCustomers" />

        @if (userService.CurrentUser.Role == UserRole.Admin)
        {
            <GridColumn Width="150">
                <Template>
                    @{
                        var customer = context as Customer;
                    }
                    <div style="display: flex; gap: 5px;">
                        <SfButton IconCss="e-icons e-list-unordered" CssClass="e-flat"
                                  OnClick="@(() => ViewListOfCustomersOrders(customer))" />

                        <SfButton IconCss="e-icons e-edit" CssClass="e-flat"
                                  OnClick="@(() => ViewEditCustomer(customer))" />

                        <SfButton IconCss="e-icons e-delete" CssClass="e-flat"
                                  Disabled="@(!customer.Active)"
                                  OnClick="@(() => ArchiveCustomerAsync(customer))" />
                    </div>
                </Template>
            </GridColumn>
        }
        else
        {
            <GridColumn Width="100">
                <Template>
                    @{
                        var customer = context as Customer;
                    }
                    <div style="display: flex; gap: 5px;">
                        <SfButton IconCss="e-icons e-list-unordered" CssClass="e-flat"
                                  OnClick="@(() => ViewListOfCustomersOrders(customer))" />

                        <SfButton IconCss="e-icons e-eye" CssClass="e-flat"
                                  OnClick="@(() => ViewEditCustomer(customer))" />
                    </div>
                </Template>
            </GridColumn>
        }
    </GridColumns>
</SfGrid>

<SfDialog @ref="ordersListDialog" Visible="false" ShowCloseIcon="true" Width="70%">
    <DialogTemplates>
        <Content>
            <CustomersOrders CusNo="@ordersListDialogCustomerId" />
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @ref="customerViewEditDialog" Visible="false" ShowCloseIcon="true" IsModal="true" Width="60%" >
    <DialogEvents Closed="@CustomerViewEditDialogClosed" />
    <DialogTemplates>
        <Content>
            <CustomerViewEdit ThisCustomer="selectedCustomer" Editable="@(userService.CurrentUser.Role == UserRole.Admin)"/>
            @if (userService.CurrentUser.Role == UserRole.Admin)
            {
                <div style="display: flex; justify-content: flex-end; width: 100%; padding: 15px 0;">
                    <SfButton IsPrimary="true" OnClick="SaveEditedCustomer">Save</SfButton>
                </div>
            }
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @ref="addCustomerChangeLogDialog" Visible="false" ShowCloseIcon="true" IsModal="true" Width="60%">
    <DialogTemplates>
        <Content>
            <CustomerChangesLogViewEdit ThisLog="customerChanges" Editable="true" />
            <div style="display: flex; justify-content: flex-end; width: 100%; padding: 15px 0;">
                <SfButton IsPrimary="true" OnClick="SaveCustomerChangeLog">Save</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    public IEnumerable<Customer> allCustomers { get; set; }
    public IEnumerable<Customer> filteredCustomers { get; set; }
    public SfGrid<Customer> Grid { get; set; }
    public bool showArchivedCustomers = false;
    public Customer selectedCustomer;
    private List<Object> ToolbarItems = new List<Object>() { "Add", "Search" };

    protected override async Task OnInitializedAsync()
    {
        userService.OnUserChanged += OnUserChanged;
        await RefreshCustomers();
        await base.OnInitializedAsync();
    }

    private async Task RefreshCustomers()
    {
        allCustomers = await customerService.GetCustomersAsync();
        await RefreshCustomerFilter();
    }

    private async Task RefreshCustomerFilter()
    {
        if (showArchivedCustomers)
        {
            filteredCustomers = allCustomers;
        }
        else
        {
            filteredCustomers = allCustomers.Where(c => c.Active == true);
        }
    }

    private void ChangeCustomerFilter(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        RefreshCustomerFilter();
    }

    #region Datagrid handlers
    private async Task ActionBeginHandler(ActionEventArgs<Customer> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Save))
        {
            args.Cancel = true;
            if (args.Action == "Add")
            {
                customerService.AddCustomerAsync(args.Data);
                await RefreshCustomers();
            }
            else if (args.Action == "Edit")
            {
                customerService.UpdateCustomerAsync(args.Data);
                await RefreshCustomers();
            }
        }
        else if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Delete))
        {
            args.Cancel = true;
            customerService.ArchiveCustomerAsync(args.Data);
            await RefreshCustomers();
        }
    }

    private async void ViewEditCustomer(Customer customer)
    {
        selectedCustomer = customer;
        customerViewEditDialog.ShowAsync();
    }

    private async void ArchiveCustomerAsync(Customer customer)
    {
        await customerService.ArchiveCustomerAsync(customer);
        await RefreshCustomers();
    }

    private void ViewListOfCustomersOrders(Customer customer)
    {
        ordersListDialogCustomerId = customer.CustomerId.ToString();
        ordersListDialog.ShowAsync();
    }

    public string GetHeader(Customer arg)
    {
        return arg.CustomerId == 0
            ? "New Customer"
            : "Edit Record of " + arg.CustomerName;
    }
    #endregion

    #region Dialog handlers
    private SfDialog customerViewEditDialog;
    private SfDialog addCustomerChangeLogDialog;
    private SfDialog ordersListDialog;
    private string ordersListDialogCustomerId = string.Empty;

    private async void SaveEditedCustomer()
    {
        await customerService.UpdateCustomerAsync(selectedCustomer);
        await customerViewEditDialog.HideAsync();
        customerChanges.CustomerId = selectedCustomer.CustomerId;
        customerChanges.Customer = selectedCustomer;
        await addCustomerChangeLogDialog.ShowAsync();
    }

    private async void CustomerViewEditDialogClosed()
    {
        selectedCustomer = null;
        if (userService.CurrentUser.Role == UserRole.Admin)
        {
            await RefreshCustomers();
        }
    }

    private CustomerChangesLog customerChanges = new();

    private async void SaveCustomerChangeLog()
    {
        await addCustomerChangeLogDialog.HideAsync();
        await customerChangesServices.AddCustomerChangesLogAsync(customerChanges);
        await RefreshCustomers();
    }

    #endregion

    private async void OnUserChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        userService.OnUserChanged -= OnUserChanged;
    }
}

<style>
    .flexrow {
        display:flex;
        flex-direction:row;
        align-items:flex-end;
        gap:15px;
    }

    .flexcolumn {
        display:flex;
        flex-direction:column;
        align-items:flex-start;
        gap:15px;
    }

    .content-wrapper {
        margin-top: 47px;
    }

    .switch-control .heading {
        text-indent: 15px;
        padding: 15px 0;
    }

    .switch-control div {
        display: flex;
        align-items: center;
    }

    .switch-control {
        margin: 0 auto;
        width: 275px;
    }

        .switch-control label {
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
            user-select: none;
            font-weight: 400;
            font-size: 13px;
        }

        .switch-control .e-disabled {
            pointer-events: none;
        }
</style>