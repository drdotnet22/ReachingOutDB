@page "/mailingnotes"

@using ReachingOutDB.Data
@using Syncfusion.Blazor.MultiColumnComboBox

@inject CustomerServices customerService
@inject CustomerStateServices customerStateService
@inject SfDialogService DialogService
@implements IDisposable

<PageTitle>Mailing Notes</PageTitle>
<h3>MailingNotes</h3>

<SfToolbar>
    <ToolbarEvents Clicked="ToolbarClickHandler" />
    <ToolbarItems>
        <ToolbarItem Text="Add" TooltipText="New mailing notes." PrefixIcon="e-duplicate icon" />
        <ToolbarItem Type="ItemType.Spacer" />
        <ToolbarItem TooltipText="Search grid contents including mailing notes" Type="ItemType.Input" Overflow="OverflowOption.Show">
            <Template>
                <SfTextBox @ref="ToolbarSearchBox" Width="200px" Placeholder="Search" Type="InputType.Search" ValueChanged="SearchGrid" ShowClearButton="true" />
            </Template>
        </ToolbarItem>
    </ToolbarItems>
</SfToolbar>

<SfGrid @ref="@Grid" DataSource="customersWithMailingNotes" RowHeight="25">
    <GridEvents CommandClicked="CommandClickedHandler" TValue="Customer" />
    <GridSortSettings>
        <GridSortColumns>
            <GridSortColumn Field="CustomerName" Direction="Syncfusion.Blazor.Grids.SortDirection.Ascending" />
        </GridSortColumns>
    </GridSortSettings>
    <GridColumns>
        <GridColumn Field="@nameof(Customer.CustomerId)" HeaderText="Customer ID" />
        <GridColumn Field="@nameof(Customer.CustomerName)" HeaderText="Customer Name" />
        <GridColumn Field="@nameof(Customer.MailingNotes)" HeaderText="Mailing Notes" Width="0"/>
        <GridColumn Width="152">
            <GridCommandColumns>
                <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
                <GridCommandColumn Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-delete", CssClass = "e-flat" })" />
            </GridCommandColumns>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @ref="addMailingNotesDialog" Visible="false" ShowCloseIcon="true" Width="50%">
    <DialogTemplates>
        <Content>
            <div class="myflexrow">
                <SfMultiColumnComboBox TItem="Customer" TValue="Customer" AllowFiltering="true"
                        FilterType="Syncfusion.Blazor.MultiColumnComboBox.FilterType.Contains"
                        @bind-Value="selectedCustomer"
                        DataSource="customers"
                        ValueField="CustomerId"
                        TextField="CustomerName"
                        Width="400px"
                        Placeholder="Customer" FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Always">
                    <MultiColumnComboboxColumns>
                        <MultiColumnComboboxColumn Field="CustomerId" Header="ID" Width="80px" />
                        <MultiColumnComboboxColumn Field="CustomerName" Header="Customer Name" />
                    </MultiColumnComboboxColumns>
                </SfMultiColumnComboBox>
                <SfButton OnClick="CreateMailingNotes" IsPrimary="true">Create Mailing Notes</SfButton>
                <SfButton OnClick="CancelAddMailingNotes">Cancel</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @ref="editMailingNotesDialog" Visible="false" ShowCloseIcon="true" Width="80%" AllowDragging="true" IsModal="true">
    <DialogEvents Closed="@EditMailingNotesDialogClosedHandler" />
    <DialogTemplates>
        <Header>
            <div class="myflexrow">
                <span>@selectedCustomer.CustomerId.ToString() - @selectedCustomer.CustomerName</span>
                <div id="customer-tooltip">
                    <SfButton CssClass="e-flat" IconCss="e-icons e-eye" id="customer-info" Disabled="@(selectedCustomer == null || selectedCustomer.CustomerId == 0)" tabindex="-1" />
                </div>
                <SfTooltip Position="Syncfusion.Blazor.Popups.Position.BottomCenter" Target="#customer-info" WindowCollision="true" TargetContainer="#customer-tooltip" OpensOn="Hover" Width="1200" Height="400">
                    <ContentTemplate>
                        <ReachingOutDB.Components.Pages.Customers.CustomerViewEdit Editable="false" ThisCustomer="selectedCustomer" />
                    </ContentTemplate>
                </SfTooltip>
            </div>
        </Header>
        <Content>
            <MailingNotesEditor @ref="mailingNotesEditor" SelectedCustomer="selectedCustomer" />
        </Content>
    </DialogTemplates>
    <DialogPositionData X="center" Y="150" />
</SfDialog>

@code {
    public SfGrid<Customer> Grid { get; set; }
    IEnumerable<Customer> customers;
    IEnumerable<Customer> customersWithMailingNotes;
    public Customer selectedCustomer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshCustomers();
        customerStateService.OnCustomerUpdated += HandleCustomerUpdatedElsewhere;
        await base.OnInitializedAsync();
    }

    private async Task RefreshCustomers()
    {
        customers = await customerService.GetCustomersAsync();
        customersWithMailingNotes = customers.Where(c => c.MailingNotes != null);
        StateHasChanged();
    }

    private async Task HandleCustomerUpdatedElsewhere(int customerId)
    {
        try
        {
            await InvokeAsync(RefreshCustomers);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    #region Datagrid Handlers
    public async Task CommandClickedHandler(CommandClickEventArgs<Customer> args)
    {
        if (args.CommandColumn.Type == CommandButtonType.Edit)
        {
            selectedCustomer = args.RowData;
            OpenEditMailingNotesDialog();
        }
        else if (args.CommandColumn.Type == CommandButtonType.Delete)
        {
            selectedCustomer = args.RowData;
            bool isConfirm = await DialogService.ConfirmAsync("Are you sure you want to permanently delete the mailing notes for this customer?", "Delete");
            if (isConfirm)
            {
                selectedCustomer.MailingNotes = null;
                await customerService.UpdateCustomerAsync(selectedCustomer);
                await RefreshCustomers();
            }
        }
    }
    #endregion

    #region Toolbar Handlers
    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Text == "Add")
        {
            selectedCustomer = null;
            OpenAddMailingNotesDialog();
        }
    }

    public SfTextBox ToolbarSearchBox;
    private async Task SearchGrid()
    {
        Grid.SearchAsync(ToolbarSearchBox.Value);
    }
    #endregion

    #region Dialog Handlers
    private SfDialog addMailingNotesDialog;
    private SfDialog editMailingNotesDialog;
    private MailingNotesEditor mailingNotesEditor;

    private void OpenAddMailingNotesDialog()
    {
        addMailingNotesDialog.ShowAsync();
    }
    private void CreateMailingNotes()
    {
        addMailingNotesDialog.HideAsync();
        editMailingNotesDialog.ShowAsync();
    }
    private void CancelAddMailingNotes()
    {
        addMailingNotesDialog.HideAsync();
    }

    private void OpenEditMailingNotesDialog()
    {
        editMailingNotesDialog.ShowAsync();
    }
    private async Task EditMailingNotesDialogClosedHandler(Syncfusion.Blazor.Popups.CloseEventArgs args)
    {
        selectedCustomer.Version = await customerService.UpdateMailingNotesAsync(selectedCustomer.CustomerId, selectedCustomer.MailingNotes); // prevent any future saves from overwriting the latest version of the mailing notes
        mailingNotesEditor?.ReleaseLock();
        await RefreshCustomers();
    }
    #endregion

    public void Dispose()
    {
        customerStateService.OnCustomerUpdated -= HandleCustomerUpdatedElsewhere;        
    }
}
