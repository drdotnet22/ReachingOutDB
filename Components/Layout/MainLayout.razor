@inherits LayoutComponentBase
@using ReachingOutDB.Components.Pages.Users
@using ReachingOutDB.Components.Shared

<FluentLayout>
    <FluentHeader>
        <a href="/">
            <img src="favicon.png" style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid; border-color:black; background-color:white; object-fit:contain; padding: 2px; box-sizing: border-box; display:block;" />
        </a>
        <FluentSpacer Width="15" />
        <span>Haines Printing • Reaching Out Database</span>
        <FluentSpacer />
        <div class="myflexrow">
            <YearQuarterSelector />
            <UserSelector />
        </div>
    </FluentHeader>
    <FluentStack Class="main" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <span>©2025, Ryan Stauffer</span>
    </FluentFooter>
</FluentLayout>
<FluentDialogProvider />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<SfDialogProvider />
