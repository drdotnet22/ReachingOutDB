@using ReachingOutDB.Data

<SfNumericTextBox @bind-Value="SelectedYear"
        @onchange="ValuesChanged"
        Format="####"
        Width="200px" />

<SfDropDownList TItem="string" TValue="Quarter"
        @bind-Value="SelectedQuarter"
        DataSource="@quarterValues"
        Width="200px">
        <DropDownListEvents TItem="string" TValue="Quarter" ValueChange="OnQuarterChange" />
</SfDropDownList>

@code {
    [Parameter]
    public int SelectedYear { get; set; }

    [Parameter]
    public EventCallback<int> SelectedYearChanged { get; set; }

    [Parameter]
    public Quarter SelectedQuarter { get; set; }

    [Parameter]
    public EventCallback<Quarter> SelectedQuarterChanged { get; set; }

    public string[] quarterValues = Quarter.GetNames(typeof(Quarter));

    protected override async Task OnInitializedAsync()
    {
        if (SelectedYear == 0 && SelectedQuarter == 0)
        {
            SelectedYear = DateTime.UtcNow.Year;
            int month = DateTime.UtcNow.Month;

            if (month >= 2 && month <= 4)
            {
                SelectedQuarter = Quarter.Q2;
            }
            else if (month >= 5 && month <= 7)
            {
                SelectedQuarter = Quarter.Q3;
            }
            else if (month >= 8 && month <= 10)
            {
                SelectedQuarter = Quarter.Q4;
            }
            else if (month >= 11)
            {
                SelectedQuarter = Quarter.Q1;
                SelectedYear++;
            }
            else
            {
                SelectedQuarter = Quarter.Q1;
            }

            ValuesChanged();
        }
        await base.OnInitializedAsync();
    }

    async Task ValuesChanged()
    {
        await SelectedYearChanged.InvokeAsync(SelectedYear);
        await SelectedQuarterChanged.InvokeAsync(SelectedQuarter);
    }

    public async Task OnQuarterChange(ChangeEventArgs<Quarter, string> args)
    {
        await SelectedQuarterChanged.InvokeAsync(SelectedQuarter);
    }
}
