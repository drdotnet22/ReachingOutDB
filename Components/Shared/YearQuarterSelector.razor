@using ReachingOutDB.Data

@inject YearQuarterService yearQuarterService

<SfButtonGroup>
    <ButtonGroupButton IconCss="e-icons e-chevron-left" @onclick="PreviousQuarter" />
    <ButtonGroupButton IconCss="e-icons e-chevron-right" @onclick="NextQuarter" />
</SfButtonGroup>

<SfNumericTextBox @bind-Value="yearQuarterService.SelectedYear"
        Format="####"
        Width="125px" />

<SfDropDownList TItem="string" TValue="Quarter"
        @bind-Value="yearQuarterService.SelectedQuarter"
        DataSource="@quarterValues"
        Width="100px">
        <DropDownListEvents TItem="string" TValue="Quarter" />
</SfDropDownList>

@code {
    public string[] quarterValues = Quarter.GetNames(typeof(Quarter));

    protected override async Task OnInitializedAsync()
    {
        if (yearQuarterService.SelectedYear == 0)
        {
            yearQuarterService.CalculateYearQuarterAsync();
        }
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            yearQuarterService.CalculateYearQuarterAsync();
        }
    }

    private void NextQuarter()
    {
        if (yearQuarterService.SelectedQuarter == Quarter.Q4)
        {
            yearQuarterService.SelectedYear++;
            yearQuarterService.SelectedQuarter = Quarter.Q1;
        }
        else
        {
            yearQuarterService.SelectedQuarter++;
        }
    }

    private void PreviousQuarter()
    {
        if (yearQuarterService.SelectedQuarter == Quarter.Q1)
        {
            yearQuarterService.SelectedYear--;
            yearQuarterService.SelectedQuarter = Quarter.Q4;
        }
        else
        {
            yearQuarterService.SelectedQuarter--;
        }
    }
}
